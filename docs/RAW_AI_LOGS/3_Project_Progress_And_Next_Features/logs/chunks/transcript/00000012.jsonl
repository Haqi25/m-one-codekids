36:   code      String         @unique\n37:   teacherId String\n38:   teacher   User           @relation(fields: [teacherId], references: [id], onDelete: Cascade)\n39:   students  ChildProfile[]\n40:   createdAt DateTime      \n<truncated 923 bytes>\nel Progress {\n67:   id          String       @id @default(cuid())\n68:   childId     String\n69:   child       ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)\n70:   missionId   String\n71:   completed   Boolean      @default(false)\n72:   stars       Int          @default(0)\n73:   bestScore   Int          @default(0)\n74:   bestBlocks  Int?\n75:   attempts    Int          @default(0)\n76:   hintsUsed   Int          @default(0)\n77:   completedAt DateTime?\n78:   updatedAt   DateTime     @updatedAt\n79: \n80:   @@unique([childId, missionId])\n81: }\n82: \n83: model Attempt {\n84:   id          String       @id @default(cuid())\n85:   childId     String\n86:   child       ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)\n87:   missionId   String\n88:   success     Boolean\n89:   blocksUsed  Int\n90:   hintsUsed   Int          @default(0)\n91:   stars       Int          @default(0)\n92:   score       Int          @default(0)\n93:   durationSec Int          @default(0)\n94:   createdAt   DateTime     @default(now())\n95: \n96:   @@index([childId, createdAt])\n97: }\n98: \n99: model ChildBadge {\n100:   id       String       @id @default(cuid())\n101:   childId  String\n102:   child    ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)\n103:   badgeId  String\n104:   earnedAt DateTime     @default(now())\n105: \n106:   @@unique([childId, badgeId])\n107: }\n108: \n109: model ChatLog {\n110:   id        String       @id @default(cuid())\n111:   childId   String\n112:   child     ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)\n113:   missionId String\n114:   role      String // \"child\" | \"bibi\"\n115:  