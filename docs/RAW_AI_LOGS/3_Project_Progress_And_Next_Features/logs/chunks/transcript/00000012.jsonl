{"step_index":1052,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-14T03:00:28Z","content":"Created At: 2026-10-14T10:00:28+07:00\nCompleted At: 2026-10-14T10:00:28+07:00\nFile Path: `file:///e:/codekids/src/lib/session.ts`\nTotal Lines: 110\nTotal Bytes: 3428\nShowing lines 1 to 110\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import \"server-only\";\n2: import { cookies } from \"next/headers\";\n3: import { redirect } from \"next/navigation\";\n4: import { SignJWT, jwtVerify } from \"jose\";\n5: import { db } from \"./db\";\n6: \n7: // Two independent sessions: adults (parent/teacher dashboard) and children (mission area).\n8: // Signed, httpOnly, sameSite=lax cookies; role-based access is enforced in each server entry point.\n9: \n10: const ADULT_COOKIE = \"ck_adult\";\n11: const CHILD_COOKIE = \"ck_child\";\n12: const ADULT_TTL = 60 * 60 * 24 * 7; // 7 days\n13: const CHILD_TTL = 60 * 60 * 24 * 30; // 30 days\n14: \n15: function secret() {\n16:   const s = process.env.AUTH_SECRET;\n17:   if (!s || s.length < 32) throw new Error(\"AUTH_SECRET harus diisi (minimal 32 karakter).\");\n18:   return new TextEncoder().encode(s);\n19: }\n20: \n21: async function sign(payload: Record<string, unknown>, ttl: number) {\n22:   return new SignJWT(payload)\n23:     .setProtectedHeader({ alg: \"HS256\" })\n24:     .setIssuedAt()\n25:     .setExpirationTime(`${ttl}s`)\n26:     .sign(secret());\n27: }\n28: \n29: async function verify<T>(token: string | undefined): Promise<T | null> {\n30:   if (!token) return null;\n31:   try {\n32:     const { payload } = await jwtVerify(token, secret());\n33:     return payload as T;\n34:   } catch {\n35:     return null;\n36:   }\n37: }\n38: \n39: const cookieOpts = (maxAge: number) => ({\n40:   httpOnly: true,\n41:   sameSite: \"lax\" as const,\n42:   secure: process.env.NODE_ENV === \"production\",\n43:   path: \"/\",\n44:   maxAge,\n45: });\n46: \n47: /* ------------------------------ Adult ------------------------------ */\n48: \n49: export type Role = \"PA\n<truncated 287 bytes>\n{\n57:   const jar = await cookies();\n58:   const p = await verify<{ sub: string; role: Role }>(jar.get(ADULT_COOKIE)?.value);\n59:   return p ? { userId: p.sub, role: p.role } : null;\n60: }\n61: \n62: export async function requireAdult() {\n63:   const s = await getAdultSession();\n64:   if (!s) redirect(\"/akun/masuk\");\n65:   const user = await db.user.findUnique({ where: { id: s.userId } });\n66:   if (!user) redirect(\"/akun/masuk\");\n67:   return user;\n68: }\n69: \n70: export async function clearAdultSession() {\n71:   (await cookies()).delete(ADULT_COOKIE);\n72: }\n73: \n74: /* ------------------------------ Child ------------------------------ */\n75: \n76: export async function createChildSession(childId: string) {\n77:   const jar = await cookies();\n78:   jar.set(CHILD_COOKIE, await sign({ sub: childId, role: \"CHILD\" }, CHILD_TTL), cookieOpts(CHILD_TTL));\n79: }\n80: \n81: export async function getChildSession() {\n82:   const jar = await cookies();\n83:   const p = await verify<{ sub: string; role: string }>(jar.get(CHILD_COOKIE)?.value);\n84:   return p && p.role === \"CHILD\" ? { childId: p.sub } : null;\n85: }\n86: \n87: export async function requireChild() {\n88:   const s = await getChildSession();\n89:   if (!s) redirect(\"/masuk\");\n90:   const child = await db.childProfile.findUnique({ where: { id: s.childId } });\n91:   if (!child) redirect(\"/masuk\");\n92:   return child;\n93: }\n94: \n95: export async function clearChildSession() {\n96:   (await cookies()).delete(CHILD_COOKIE);\n97: }\n98: \n99: /** Can this adult view/manage this child? (RBAC, NFR-SC-03) */\n100: export async function adultCanAccessChild(userId: string, childId: string) {\n101:   const child = await db.childProfile.findUnique({\n102:     where: { id: childId },\n103:     include: { class: { select: { teacherId: true } } },\n104:   });\n105:   if (!child) return null;\n106:   if (child.parentId === userId || child.class?.teacherId === userId) return child;\n107:   return null;\n108: }\n109: \n110: \nThe above content shows the entire, complete file contents of the requested file.\n","truncated_fields":["content"]}
