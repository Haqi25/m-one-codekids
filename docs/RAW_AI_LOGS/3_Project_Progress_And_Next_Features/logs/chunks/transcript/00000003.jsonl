\n39: function withList(b: Block, slot: string, list: Block[]): Block {\n40:   if (b.type === \"repeat\" && slot === \"body\") return { ...b, body: list };\n41:   if (b.type === \"if\" && slot === \"then\") return { ...b, then: list };\n42:   if (b.type === \"if\" && slot === \"else\") return { ...b, else: list };\n43:   return b;\n44: }\n45: \n46: /** Apply fn to the list identified by key. */\n47: function mapList(program: Block[], key: ContainerKey, fn: (list: Block[]) => Block[]): Block[] {\n48:   if (key === ROOT) return fn(program);\n49:   const [ownerId, slot] = key.split(\":\");\n50:   const walk = (list: Block[]): Block[] =>\n51:     list.map((b) => {\n52:       if (b.id === ownerId) {\n53:         const current = childLists(b).find(([s]) => s === slot)?.[1];\n54:         return current ? withList(b, slot, fn(current)) : b;\n55:       }\n56:       let next = b;\n57:       for (const [s, l] of childLists(b)) next = withList(next, s, walk(l));\n58:       return next;\n59:     });\n60:   return walk(program);\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
