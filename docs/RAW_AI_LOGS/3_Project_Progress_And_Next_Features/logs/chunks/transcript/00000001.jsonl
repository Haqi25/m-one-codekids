port type Dir = \"up\" | \"down\" | \"left\" | \"right\";\n4: export type Concept = \"sequencing\" | \"looping\" | \"conditional\";\n5: \n6: /** A visual block in the child's program. */\n7: export type Block =\n8:   | { id: string; type: \"move\"; dir: Dir }\n9:   | { id: string; type: \"repeat\"; times: number; body: Block[] }\n10:   | { id: string; type: \"if\"; cond: string; then: Block[]; else: Block[] }\n11:   | { id: string; type: \"put\"; box: string };\n12: \n13: export type BlockType = Block[\"type\"];\n14: \n15: /** Palette entry (template without id). */\n16: export type PaletteItem =\n17:   | { type: \"move\"; dir: Dir }\n18:   | { type: \"repeat\"; times?: number }\n19:   | { type: \"if\"; cond?: string }\n20:   | { type: \"put\"; box: string };\n21: \n22: export interface Pos {\n23:   x: number;\n24:   y: number;\n25: }\n26: \n27: export interface GridItem {\n28:   x: number;\n29:   y: number;\n30:   emoji: string;\n31:   label: string;\n32:   /** If set, items must be collected in ascending order. */\n33:   order?: number;\n34:   /** Value added to the counter when collected (e.g. 3 apples). */\n35:   value?: number;\n36: }\n37: \n38: export interface GridBoard {\n39:   kind: \"grid\";\n40:   width: number;\n41:   height: number;\n42:   start: Pos;\n43:   goal: Pos & { emoji: string; label: string };\n44:   walls: (Pos & { emoji?: string })[];\n45:   items: GridItem[];\n46:   /** Optional counter shown while running, e.g. \"Apel\" for multiplication. */\n47:   counterLabel?: string;\n48:   /** Background theme emoji used for decoration. */\n49:   theme?: string;\n50: }\n51: \n52: export interface SortCondition {\n53:   id: string;\n54:   /** Text shown inside the IF block, e.g. \"bilangan genap\". */\n55:   label: string;\n56: }\n57: \n58: export interface SortBox {\n59:   id: string;\n60:   label: string;\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, c