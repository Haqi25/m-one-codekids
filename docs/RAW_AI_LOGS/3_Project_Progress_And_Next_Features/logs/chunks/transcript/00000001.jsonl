{"step_index":94,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-13T03:14:39Z","content":"Created At: 2026-10-13T10:14:39+07:00\nCompleted At: 2026-10-13T10:14:39+07:00\nFile Path: `file:///e:/codekids/src/lib/session.ts`\nTotal Lines: 110\nTotal Bytes: 3428\nShowing lines 1 to 70\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import \"server-only\";\n2: import { cookies } from \"next/headers\";\n3: import { redirect } from \"next/navigation\";\n4: import { SignJWT, jwtVerify } from \"jose\";\n5: import { db } from \"./db\";\n6: \n7: // Two independent sessions: adults (parent/teacher dashboard) and children (mission area).\n8: // Signed, httpOnly, sameSite=lax cookies; role-based access is enforced in each server entry point.\n9: \n10: const ADULT_COOKIE = \"ck_adult\";\n11: const CHILD_COOKIE = \"ck_child\";\n12: const ADULT_TTL = 60 * 60 * 24 * 7; // 7 days\n13: const CHILD_TTL = 60 * 60 * 24 * 30; // 30 days\n14: \n15: function secret() {\n16:   const s = process.env.AUTH_SECRET;\n17:   if (!s || s.length < 32) throw new Error(\"AUTH_SECRET harus diisi (minimal 32 karakter).\");\n18:   return new TextEncoder().encode(s);\n19: }\n20: \n21: async function sign(payload: Record<string, unknown>, ttl: number) {\n22:   return new SignJWT(payload)\n23:     .setProtectedHeader({ alg: \"HS256\" })\n24:     .setIssuedAt()\n25:     .setExpirationTime(`${ttl}s`)\n26:     .sign(secret());\n27: }\n28: \n29: async function verify<T>(token: string | undefined): Promise<T | null> {\n30:   if (!token) return null;\n31:   try {\n32:     const { payload } = await jwtVerify(token, secret());\n33:     return payload as T;\n34:   } catch {\n35:     return null;\n36:   }\n37: }\n38: \n39: const cookieOpts = (maxAge: number) => ({\n40:   httpOnly: true,\n41:   sameSite: \"lax\" as const,\n42:   secure: process.env.NODE_ENV === \"production\",\n43:   path: \"/\",\n44:   maxAge,\n45: });\n46: \n47: /* ------------------------------ Adult ------------------------------ */\n48: \n49: export type Role = \"PARENT\" | \"TEACHER\";\n50: \n51: export async function createAdultSession(userId: string, role: Role) {\n52:   const jar = await cookies();\n53:   jar.set(ADULT_COOKIE, await sign({ sub: userId, role }, ADULT_TTL), cookieOpts(ADULT_TTL));\n54: }\n55: \n56: export async function getAdultSession() {\n57:   const jar = await cookies();\n58:   const p = await verify<{ sub: string; role: Role }>(jar.get(ADULT_COOKIE)?.value);\n59:   return p ? { userId: p.sub, role: p.role } : null;\n60: }\n61: \n62: export async function requireAdult() {\n63:   const s = await getAdultSession();\n64:   if (!s) redirect(\"/akun/masuk\");\n65:   const user = await db.user.findUnique({ where: { id: s.userId } });\n66:   if (!user) redirect(\"/akun/masuk\");\n67:   return user;\n68: }\n69: \n70: export async function clearAdultSession() {\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
