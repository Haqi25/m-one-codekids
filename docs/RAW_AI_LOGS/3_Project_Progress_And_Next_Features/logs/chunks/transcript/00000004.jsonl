                            */\n200: /* ------------------------------------------------------------------ */\n201: \n202: export function runSort(board: SortBoard, program: Block[]): Omit<RunResult, \"blocksUsed\"> {\n203:   const frames: SortFrame[] = [];\n204:   let tooLong = false;\n205: \n206:   board.items.forEach((item, itemIndex) => {\n207:     let box = null as string | null;\n208:     let steps = 0;\n209:     const trail: string[] = [];\n210:     const exec = (blocks: Block[]): boolean => {\n211:       for (const b of blocks) {\n212:         if (box !== null) return false;\n213:         if (++steps > MAX_STEPS) {\n214:           tooLong = true;\n215:           return false;\n216:         }\n217:         trail.push(b.id);\n218:         if (b.type === \"put\") {\n219:           box = b.box;\n220:           return false;\n221:         }\n222:         if (b.type === \"if\") {\n223:           const branch = item.tags.includes(b.cond) ? b.then : b.else;\n224:           if (!exec(branch)) return false;\n225:         }\n226:         if (b.type === \"repeat\") {\n227:           for (let i = 0; i < b.times; i++) if (!exec(b.body)) return false;\n228:         }\n229:       }\n230:       return true;\n231:     };\n232:     exec(program);\n233:     frames.push({ itemIndex, box, correct: box === item.answer, trail });\n234:   });\n235: \n236:   if (tooLong) return { success: false, reason: \"too-long\", sortFrames: frames };\n237:   const firstBad = frames.find((f) => !f.correct);\n238:   if (firstBad) {\n239:     const item = board.items[firstBad.itemIndex];\n240:     return {\n241:       success: false,\n242:       reason: firstBad.box === null ? \"no-box\" : \"wrong-box\",\n243:       detail: item.label,\n244:       sortFrames: frames,\n245:     };\n246:   }\n247:   return { success: true, sortFrames: frames };\n248: }\n249: \n250: /* ------------------------------------------------------------------ */\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
