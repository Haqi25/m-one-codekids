{"step_index":300,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-13T05:24:25Z","content":"Created At: 2026-10-13T12:24:25+07:00\nCompleted At: 2026-10-13T12:24:25+07:00\nFile Path: `file:///e:/codekids/src/lib/missions/engine.ts`\nTotal Lines: 307\nTotal Bytes: 11131\nShowing lines 250 to 307\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n250: /* ------------------------------------------------------------------ */\n251: /* Public entry point                                                  */\n252: /* ------------------------------------------------------------------ */\n253: \n254: export function runMission(mission: Mission, program: Block[]): RunResult {\n255:   const blocksUsed = countBlocks(program);\n256:   if (program.length === 0) return { success: false, reason: \"empty\", blocksUsed };\n257: \n258:   const base = mission.board.kind === \"grid\" ? runGrid(mission.board, program) : runSort(mission.board, program);\n259:   if (!base.success) return { ...base, blocksUsed };\n260: \n261:   // Program works; check mission constraints (encourage loops / conditionals).\n262:   if (mission.mustUse) {\n263:     const used = usedTypes(program);\n264:     const missing = mission.mustUse.find((t) => !used.has(t));\n265:     if (missing) return { ...base, success: false, reason: \"must-use\", detail: missing, blocksUsed };\n266:   }\n267:   if (mission.maxBlocks !== undefined && blocksUsed > mission.maxBlocks) {\n268:     return { ...base, success: false, reason: \"too-many-blocks\", detail: String(mission.maxBlocks), blocksUsed };\n269:   }\n270:   return { ...base, blocksUsed };\n271: }\n272: \n273: const BLOCK_NAME: Record<BlockType, string> = {\n274:   move: \"Gerak\",\n275:   repeat: \"Ulangi\",\n276:   if: \"Jika\",\n277:   put: \"Masukkan\",\n278: };\n279: \n280: /** Always-positive feedback text (NFR-UX-04: no punishing \"GAGAL\" screens). */\n281: export function feedbackFor(result: RunResult): string {\n282:   switch (result.reason) {\n283:     case undefined:\n284:       return \"Hebat! Misi berhasil! 🎉\";\n285:     case \"empty\":\n286:       return \"Yuk, seret blok ke area program dulu, lalu tekan Jalankan! 🧩\";\n287:     case \"bump\":\n288:       return `Ups, kamu menabrak ${result.detail}. Hampir! Coba cek arah blokmu ya. 🙂`;\n289:     case \"wrong-order\":\n290:       return `Eits, \"${result.detail}\" belum waktunya! Urutannya perlu dicek lagi. 🔢`;\n291:     case \"missing-items\":\n292:       return `Sedikit lagi! Masih ada \"${result.detail}\" yang belum diambil. ✨`;\n293:     case \"not-at-goal\":\n294:       return `Bagus, tinggal sedikit lagi menuju ${result.detail}! 🏁`;\n295:     case \"too-many-blocks\":\n296:       return `Jalannya sudah benar! 👏 Sekarang coba pakai blok Ulangi supaya cukup ${result.detail} blok saja.`;\n297:     case \"must-use\":\n298:       return `Keren, hampir! Misi ini perlu memakai blok ${BLOCK_NAME[result.detail as BlockType] ?? result.detail}. 💡`;\n299:     case \"no-box\":\n300:       return `\"${result.detail}\" belum masuk kotak mana pun. Pastikan setiap jalur punya blok Masukkan. 📦`;\n301:     case \"wrong-box\":\n302:       return `\"${result.detail}\" masuk kotak yang kurang tepat. Coba periksa syarat JIKA-nya! 🤔`;\n303:     case \"too-long\":\n304:       return \"Programnya terlalu panjang sampai karaktermu kelelahan. Coba buat lebih sederhana! 😅\";\n305:   }\n306: }\n307: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
