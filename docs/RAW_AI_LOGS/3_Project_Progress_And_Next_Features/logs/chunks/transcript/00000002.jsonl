{"step_index":158,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-13T04:10:54Z","content":"Created At: 2026-10-13T11:10:54+07:00\nCompleted At: 2026-10-13T11:10:54+07:00\nFile Path: `file:///e:/codekids/src/app/api/bibi/route.ts`\nTotal Lines: 118\nTotal Bytes: 3729\nShowing lines 1 to 118\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import { NextResponse } from \"next/server\";\n2: import { GoogleGenAI } from \"@google/genai\";\n3: import { getChildSession } from \"@/lib/session\";\n4: import { db } from \"@/lib/db\";\n5: \n6: const ai = new GoogleGenAI({\n7:   apiKey: process.env.GEMINI_API_KEY,\n8: });\n9: \n10: export async function POST(req: Request) {\n11:   try {\n12:     const session = await getChildSession();\n13:     if (!session?.childId) {\n14:       return NextResponse.json({ error: \"Unauthorized\" }, { status: 401 });\n15:     }\n16: \n17:     const { missionId, goal, program, attempts, message, history } = await req.json();\n18: \n19:     if (!message) {\n20:       return NextResponse.json({ error: \"Message is required\" }, { status: 400 });\n21:     }\n22: \n23:     // Determine hint level based on hints used (can be inferred from history or just rely on Gemini to increment via its prompt)\n24:     const hintsUsed = history.filter((m: any) => m.role === \"bibi\").length;\n25:     let hintLevel = 1;\n26:     if (hintsUsed >= 2) hintLevel = 3;\n27:     else if (hintsUsed === 1) hintLevel = 2;\n28: \n29:     const programStr = JSON.stringify(program, null, 2);\n30: \n31:     const systemPrompt = `Kamu adalah \"Bibi AI\", tutor coding virtual untuk anak SD (7-12 tahun). \n32: Kamu sedang membantu anak menyelesaikan sebuah misi coding bergaya blok (seperti Scratch).\n33: \n34: Konteks saat ini:\n35: - Misi ID: ${missionId}\n36: - Tujuan Misi: ${goal}\n37: - Jumlah percobaan gagal: ${attempts}\n38: - Tingkat Hint (1-3): ${hintLevel}\n39: - Kode Blok anak saat ini (JSON):\n40: ${programStr}\n41: \n42: ATURAN UTAMA:\n43: 1. JANGAN PERNAH memberikan jawaban \n<truncated 635 bytes>\n kamu berada di tingkat hint: ${hintLevel}.\n52: \n53: Sesuaikan jawabanmu dengan pertanyaan anak dan konteks blok yang sudah mereka susun.`;\n54: \n55:     const chatHistory = history.map((m: any) => ({\n56:       role: m.role === \"bibi\" ? \"model\" : \"user\",\n57:       parts: [{ text: m.content }]\n58:     }));\n59: \n60:     // Add current message to chat history format\n61:     const formattedHistory = [\n62:       ...chatHistory,\n63:     ];\n64: \n65:     const response = await ai.models.generateContent({\n66:       model: \"gemini-2.5-flash\",\n67:       contents: [\n68:         { role: \"system\", parts: [{ text: systemPrompt }] },\n69:         ...formattedHistory,\n70:         { role: \"user\", parts: [{ text: message }] }\n71:       ],\n72:       config: {\n73:         temperature: 0.7,\n74:       }\n75:     });\n76: \n77:     const reply = response.text;\n78:     \n79:     // Log interaction in DB asynchronously\n80:     try {\n81:       await db.$transaction([\n82:         db.chatLog.create({\n83:           data: {\n84:             childId: session.childId,\n85:             missionId: missionId,\n86:             role: \"child\",\n87:             content: message,\n88:             hintLevel: hintLevel,\n89:           }\n90:         }),\n91:         db.chatLog.create({\n92:           data: {\n93:             childId: session.childId,\n94:             missionId: missionId,\n95:             role: \"bibi\",\n96:             content: reply || \"\",\n97:             hintLevel: hintLevel,\n98:           }\n99:         })\n100:       ]);\n101:     } catch(e) {\n102:       console.error(\"Failed to log chat:\", e);\n103:     }\n104: \n105:     return NextResponse.json({ \n106:       reply: reply,\n107:       isHint: true, // We consider every answer from Bibi as a hint\n108:     });\n109: \n110:   } catch (error) {\n111:     console.error(\"Bibi AI Error:\", error);\n112:     return NextResponse.json(\n113:       { error: \"Internal server error\" },\n114:       { status: 500 }\n115:     );\n116:   }\n117: }\n118: \nThe above content shows the entire, complete file contents of the requested file.\n","truncated_fields":["content"]}
