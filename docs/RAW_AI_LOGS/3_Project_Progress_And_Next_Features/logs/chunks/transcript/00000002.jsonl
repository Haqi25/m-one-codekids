{"step_index":171,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-13T04:13:33Z","content":"Created At: 2026-10-13T11:13:33+07:00\nCompleted At: 2026-10-13T11:13:33+07:00\nFile Path: `file:///e:/codekids/src/components/mission/TanyaBibi.tsx`\nTotal Lines: 157\nTotal Bytes: 5284\nShowing lines 1 to 90\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"use client\";\n2: \n3: import { useState, useRef, useEffect } from \"react\";\n4: import { BibiMascot } from \"@/components/brand/BibiMascot\";\n5: import { Block } from \"@/lib/missions/types\";\n6: \n7: type Message = {\n8:   role: \"user\" | \"bibi\";\n9:   content: string;\n10: };\n11: \n12: interface TanyaBibiProps {\n13:   missionId: string;\n14:   goal: string;\n15:   program: Block[];\n16:   attempts: number;\n17:   isOpen: boolean;\n18:   onClose: () => void;\n19:   onHintUsed: () => void;\n20: }\n21: \n22: export function TanyaBibi({ missionId, goal, program, attempts, isOpen, onClose, onHintUsed }: TanyaBibiProps) {\n23:   const [messages, setMessages] = useState<Message[]>([\n24:     { role: \"bibi\", content: \"Halo! Aku Bibi. Butuh bantuan dengan misi ini? 🤔\" }\n25:   ]);\n26:   const [isLoading, setIsLoading] = useState(false);\n27:   const messagesEndRef = useRef<HTMLDivElement>(null);\n28: \n29:   useEffect(() => {\n30:     if (isOpen) {\n31:       messagesEndRef.current?.scrollIntoView({ behavior: \"smooth\" });\n32:     }\n33:   }, [messages, isOpen]);\n34: \n35:   if (!isOpen) return null;\n36: \n37:   const sendMessage = async (text: string) => {\n38:     if (!text.trim() || isLoading) return;\n39: \n40:     const userMessage = { role: \"user\" as const, content: text };\n41:     setMessages((prev) => [...prev, userMessage]);\n42:     setIsLoading(true);\n43: \n44:     try {\n45:       const res = await fetch(\"/api/bibi\", {\n46:         method: \"POST\",\n47:         headers: { \"Content-Type\": \"application/json\" },\n48:         body: JSON.stringify({\n49:           missionId,\n50:           goal,\n51:           program,\n52:           attempts,\n53:           message: text,\n54:           history: messages.filter(m => m.role !== \"bibi\" || m.content !== \"Halo! Aku Bibi. Butuh bantuan dengan misi ini? 🤔\")\n55:         }),\n56:       });\n57: \n58:       if (!res.ok) throw new Error(\"Gagal mengambil respon\");\n59:       \n60:       const data = await res.json();\n61:       setMessages((prev) => [...prev, { role: \"bibi\", content: data.reply }]);\n62:       \n63:       if (data.isHint) {\n64:         onHintUsed();\n65:       }\n66:     } catch (error) {\n67:       setMessages((prev) => [...prev, { role: \"bibi\", content: \"Maaf, Bibi sedang sibuk. Coba lagi nanti ya! 😟\" }]);\n68:     } finally {\n69:       setIsLoading(false);\n70:     }\n71:   };\n72: \n73:   const quickQuestions = [\n74:     \"Aku bingung mulai dari mana\",\n75:     \"Jelaskan pakai contoh dong\",\n76:     \"Blok mana yang salah?\"\n77:   ];\n78: \n79:   return (\n80:     <div className=\"absolute bottom-4 right-4 w-80 sm:w-96 bg-white rounded-2xl shadow-pop flex flex-col overflow-hidden z-50 border-2 border-navy/10 animate-pop-in\">\n81:       {/* Header */}\n82:       <div className=\"bg-peach px-4 py-3 flex justify-between items-center border-b-2 border-navy/10\">\n83:         <div className=\"flex items-center gap-2\">\n84:           <BibiMascot mood=\"happy\" className=\"w-8 h-8\" />\n85:           <h3 className=\"font-display font-bold text-navy\">Tanya Bibi AI</h3>\n86:         </div>\n87:         <button onClick={onClose} className=\"text-navy-700 hover:text-navy font-bold p-1\">\n88:           ✕\n89:         </button>\n90:       </div>\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
