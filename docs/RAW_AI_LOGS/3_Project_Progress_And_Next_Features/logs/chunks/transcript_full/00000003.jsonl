{"step_index":247,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-13T04:58:23Z","content":"Created At: 2026-10-13T11:58:23+07:00\nCompleted At: 2026-10-13T11:58:24+07:00\nFile Path: `file:///e:/codekids/src/lib/missions/program.ts`\nTotal Lines: 198\nTotal Bytes: 7030\nShowing lines 1 to 60\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: // Immutable operations on the nested block program (used by the drag-and-drop editor).\n2: // A \"container key\" identifies a list of blocks: \"root\" | `${blockId}:body` | `${blockId}:then` | `${blockId}:else`.\n3: \n4: import type { Block, PaletteItem } from \"./types\";\n5: \n6: export type ContainerKey = string;\n7: export const ROOT: ContainerKey = \"root\";\n8: export const MAX_DEPTH = 3;\n9: \n10: let counter = 0;\n11: export function newId(): string {\n12:   counter += 1;\n13:   return `b${Date.now().toString(36)}${counter.toString(36)}${Math.random().toString(36).slice(2, 6)}`;\n14: }\n15: \n16: export function fromPalette(item: PaletteItem, defaultCond?: string): Block {\n17:   switch (item.type) {\n18:     case \"move\":\n19:       return { id: newId(), type: \"move\", dir: item.dir };\n20:     case \"repeat\":\n21:       return { id: newId(), type: \"repeat\", times: item.times ?? 2, body: [] };\n22:     case \"if\":\n23:       return { id: newId(), type: \"if\", cond: item.cond ?? defaultCond ?? \"\", then: [], else: [] };\n24:     case \"put\":\n25:       return { id: newId(), type: \"put\", box: item.box };\n26:   }\n27: }\n28: \n29: function childLists(b: Block): [string, Block[]][] {\n30:   if (b.type === \"repeat\") return [[\"body\", b.body]];\n31:   if (b.type === \"if\")\n32:     return [\n33:       [\"then\", b.then],\n34:       [\"else\", b.else],\n35:     ];\n36:   return [];\n37: }\n38: \n39: function withList(b: Block, slot: string, list: Block[]): Block {\n40:   if (b.type === \"repeat\" && slot === \"body\") return { ...b, body: list };\n41:   if (b.type === \"if\" && slot === \"then\") return { ...b, then: list };\n42:   if (b.type === \"if\" && slot === \"else\") return { ...b, else: list };\n43:   return b;\n44: }\n45: \n46: /** Apply fn to the list identified by key. */\n47: function mapList(program: Block[], key: ContainerKey, fn: (list: Block[]) => Block[]): Block[] {\n48:   if (key === ROOT) return fn(program);\n49:   const [ownerId, slot] = key.split(\":\");\n50:   const walk = (list: Block[]): Block[] =>\n51:     list.map((b) => {\n52:       if (b.id === ownerId) {\n53:         const current = childLists(b).find(([s]) => s === slot)?.[1];\n54:         return current ? withList(b, slot, fn(current)) : b;\n55:       }\n56:       let next = b;\n57:       for (const [s, l] of childLists(b)) next = withList(next, s, walk(l));\n58:       return next;\n59:     });\n60:   return walk(program);\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
