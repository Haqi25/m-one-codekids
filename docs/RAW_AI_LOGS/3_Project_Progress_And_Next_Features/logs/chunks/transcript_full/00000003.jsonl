ks) {\n45:     acc.add(b.type);\n46:     if (b.type === \"repeat\") usedTypes(b.body, acc);\n47:     if (b.type === \"if\") {\n48:       usedTypes(b.then, acc);\n49:       usedTypes(b.else, acc);\n50:     }\n51:   }\n52:   return acc;\n53: }\n54: \n55: /** Human-readable program text, used as context for Bibi AI (FR-AI-02). */\n56: export function describeProgram(blocks: Block[], mission?: Mission, indent = \"\"): string {\n57:   if (blocks.length === 0) return `${indent}(kosong)`;\n58:   const condLabel = (id: string) =>\n59:     mission?.board.kind === \"sort\"\n60:       ? mission.board.conditions.find((c) => c.id === id)?.label ?? id\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
