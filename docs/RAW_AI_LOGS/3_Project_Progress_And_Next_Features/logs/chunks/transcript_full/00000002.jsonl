     const res = await fetch(\"/api/bibi\", {\n46:         method: \"POST\",\n47:         headers: { \"Content-Type\": \"application/json\" },\n48:         body: JSON.stringify({\n49:           missionId,\n50:           goal,\n51:           program,\n52:           attempts,\n53:           message: text,\n54:           history: messages.filter(m => m.role !== \"bibi\" || m.content !== \"Halo! Aku Bibi. Butuh bantuan dengan misi ini? 🤔\")\n55:         }),\n56:       });\n57: \n58:       if (!res.ok) throw new Error(\"Gagal mengambil respon\");\n59:       \n60:       const data = await res.json();\n61:       setMessages((prev) => [...prev, { role: \"bibi\", content: data.reply }]);\n62:       \n63:       if (data.isHint) {\n64:         onHintUsed();\n65:       }\n66:     } catch (error) {\n67:       setMessages((prev) => [...prev, { role: \"bibi\", content: \"Maaf, Bibi sedang sibuk. Coba lagi nanti ya! 😟\" }]);\n68:     } finally {\n69:       setIsLoading(false);\n70:     }\n71:   };\n72: \n73:   const quickQuestions = [\n74:     \"Aku bingung mulai dari mana\",\n75:     \"Jelaskan pakai contoh dong\",\n76:     \"Blok mana yang salah?\"\n77:   ];\n78: \n79:   return (\n80:     <div className=\"absolute bottom-4 right-4 w-80 sm:w-96 bg-white rounded-2xl shadow-pop flex flex-col overflow-hidden z-50 border-2 border-navy/10 animate-pop-in\">\n81:       {/* Header */}\n82:       <div className=\"bg-peach px-4 py-3 flex justify-between items-center border-b-2 border-navy/10\">\n83:         <div className=\"flex items-center gap-2\">\n84:           <BibiMascot mood=\"happy\" className=\"w-8 h-8\" />\n85:           <h3 className=\"font-display font-bold text-navy\">Tanya Bibi AI</h3>\n86:         </div>\n87:         <button onClick={onClose} className=\"text-navy-700 hover:text-navy font-bold p-1\">\n88:           ✕\n89:         </button>\n90:       </div>\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not show