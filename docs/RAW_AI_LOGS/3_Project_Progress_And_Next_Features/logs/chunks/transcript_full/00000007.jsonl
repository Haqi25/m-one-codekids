| y > maxY) return false;\n  // Corner checks\n  if (x < minX + radius && y < minY + radius) {\n    const dx = x - (minX + radius);\n    const dy = y - (minY + radius);\n    return dx * dx + dy * dy <= radius * radius;\n  }\n  if (x > maxX - radius && y < minY + radius) {\n    const dx = x - (maxX - radius);\n    const dy = y - (minY + radius);\n    return dx * dx + dy * dy <= radius * radius;\n  }\n  if (x < minX + radius && y > maxY - radius) {\n    const dx = x - (minX + radius);\n    const dy = y - (maxY - radius);\n    return dx * dx + dy * dy <= radius * radius;\n  }\n  if (x > maxX - radius && y > maxY - radius) {\n    const dx = x - (maxX - radius);\n    const dy = y - (maxY - radius);\n    return dx * dx + dy * dy <= radius * radius;\n  }\n  return true;\n}\n\n// Draw squircle body with gradient & bottom shadow\nfor (let y = 0; y < H; y++) {\n  for (let x = 0; x < W; x++) {\n    if (isInsideSquircle(x, y)) {\n      if (y >= 26) {\n        // Bottom shadow border\n        setPixel(x, y, 212, 93, 8, 255);\n      } else {\n        // Gradient orange\n        const t = y / 28;\n        const r = Math.round(255 * (1 - t) + 242 * t);\n        const g = Math.round(164 * (1 - t) + 115 * t);\n        const b = Math.round(71 * (1 - t) + 26 * t);\n        setPixel(x, y, r, g, b, 255);\n      }\n    }\n  }\n}\n\n// Draw code symbols: < / >\n// < bracket\nconst leftBracket = [\n  [10, 11], [11, 11],\n  [9, 12], [10, 12],\n  [8, 13], [9, 13],\n  [7, 14], [8, 14],\n  [6, 15], [7, 15],\n  [6, 16], [7, 16],\n  [7, 17], [8, 17],\n  [8, 18], [9, 18],\n  [9, 19], [10, 19],\n  [10, 20], [11, 20]\n];\nleftBracket.forEach(([x, y]) => setPixel(x, y, 255, 255, 255, 255));\n\n// > bracket\nconst rightBracket = [\n  [21, 11], [22, 11],\n  [22, 12], [23, 12],\n  [23, 13], [24, 13],\n  [24, 14], [25, 14],\n  [25, 15], [26, 15],\n  [25, 16], [26, 16],\n  [24, 17], [25, 17],\n  [23, 18], [24, 18],\n  [22, 19], [23, 19],\n  [21, 20], [22, 20]\n];\nrightBracket.forEach(([x, y]) => setPixel(x, y, 255, 255, 255, 255));\n\n// / slash (yellowish)\nconst slash = [\n  [18, 10], [19, 10],\n  [17, 11], [18, 11],\n  [17, 12], [18, 12],\n  [16, 13], [17, 13],\n  [16, 14], [17, 14],\n  [15, 15], [16, 15],\n  [15, 16], [16, 16],\n  [14, 17], [15, 17],\n  [14, 18], [15, 18],\n  [13, 19], [14, 19],\n  [13, 20], [14, 20],\n  [12, 21], [13, 21]\n];\nslash.forEach(([x, y]) => setPixel(x, y, 255, 235, 160, 255));\n\n// Star sparkle top right\nsetPixel(25, 6, 255, 245, 180, 255);\nsetPixel(24, 7, 255, 245, 180, 255);\nsetPixel(25, 7, 255, 255, 255, 255);\nsetPixel(26, 7, 255, 245, 180, 255);\nsetPixel(25, 8, 255, 245, 180, 255);\n\n// Build ICO file format\nconst header = Buffer.alloc(6);\nheader.writeUInt16LE(0, 0); // Reserved\nheader.writeUInt16LE(1, 2); // ICO type\nheader.writeUInt16LE(1, 4); // 1 image\n\nconst dirEntry = Buffer.alloc(16);\ndirEntry.writeUInt8(W, 0);   // Width\ndirEntry.writeUInt8(H, 1);   // Height\ndirEntry.writeUInt8(0, 2);   // Colors\ndirEntry.writeUInt8(0, 3);   // Reserved\ndirEntry.writeUInt16LE(1, 4); // Planes\ndirEntry.writeUInt16LE(32, 6); // 32 bpp\nconst imgSize = 40 + (W * H * 4) + (W * H / 8);\ndirEntry.writeUInt32LE(imgSize, 8); // Size of image data\ndirEntry.writeUInt32LE(22, 12);     // Offset of image data\n\nconst bmiHeader = Buffer.alloc(40);\nbmiHeader.writeUInt32LE(40, 0);     // Header size\nbmiHeader.writeInt32LE(W, 4);       // Width\nbmiHeader.writeInt32LE(H * 2, 8);   // Height * 2 (BMP convention in ICO)\nbmiHeader.writeUInt16LE(1, 12);     // Planes\nbmiHeader.writeUInt16LE(32, 14);    // Bit count\nbmiHeader.writeUInt32LE(0, 16);     // Compression (BI_RGB)\nbmiHeader.writeUInt32LE(W * H * 4, 20); // Image size\nbmiHeader.writeInt32LE(0, 24);      // XPelsPerMeter\nbmiHeader.writeInt32LE(0, 28);      // YPelsPerMeter\nbmiHeader.writeUInt32LE(0, 32);     // ClrUsed\nbmiHeader.writeUInt32LE(0, 36);     // ClrImportant\n\nconst andMask = Buffer.alloc(W * H / 8, 0); // 0 = not transparent mask\n\nconst icoBuffer = Buffer.concat([header, dirEntry, bmiHeader, pixels, andMask]);\n\nfs.writeFileSync('e:/codekids/public/favicon.ico', icoBuffer);\nfs.writeFileSync('e:/codekids/src/app/favicon.ico', icoBuffer);\nconsole.log('Successfully wrote favicon.ico files!');\n","Description":"Generate favicon.ico script","Overwrite":true,"TargetFile":"C:/Users/Hawi/.gemini/antigravity/brain/21f4c65e-0635-42cf-84ce-24f0e402288b/scratch/generate_ico.js","toolAction":"Writing scratch generator","toolSummary":"Favicon generator script"}}]}
