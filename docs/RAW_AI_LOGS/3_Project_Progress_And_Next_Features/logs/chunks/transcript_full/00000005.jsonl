{"step_index":335,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-13T05:53:58Z","input_tokens":4236,"cache_read_tokens":223788,"output_tokens":6719,"thinking":"Restructuring the `BlockEditor` component requires defining a `DragPayload` type to handle palette items and existing block IDs. The `handlePaletteDragStart` and `handleBlockDragStart` functions must serialize the respective payload types into `dataTransfer`. A dedicated `DropZone` component with visual cues is necessary for improved user interaction.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"\"use client\";\n\nimport type { Block, BlockType, Mission, PaletteItem, SortBox, SortCondition } from \"@/lib/missions/types\";\nimport { useState } from \"react\";\nimport { fromPalette, insertAt, moveBlock, newId, nudgeBlock, removeBlock, updateBlock } from \"@/lib/missions/program\";\n\ntype DragPayload =\n  | { type: \"palette\"; item: PaletteItem }\n  | { type: \"block\"; id: string };\n\nexport function BlockEditor({\n  mission,\n  program,\n  onChange,\n  palette,\n}: {\n  mission?: Mission;\n  program: Block[];\n  onChange: (prog: Block[]) => void;\n  palette: PaletteItem[];\n}) {\n  const [dragPayload, setDragPayload] = useState<DragPayload | null>(null);\n  const [activeDropTarget, setActiveDropTarget] = useState<string | null>(null);\n\n  const isSortBoard = mission?.board.kind === \"sort\";\n  const conditions: SortCondition[] = isSortBoard ? mission.board.conditions : [];\n  const boxes: SortBox[] = isSortBoard ? mission.board.boxes : [];\n\n  const getBoxInfo = (boxId: string) => boxes.find((b) => b.id === boxId);\n  const getCondInfo = (condId: string) => conditions.find((c) => c.id === condId);\n\n  // Palette Drag handlers\n  const handlePaletteDragStart = (e: React.DragEvent, item: PaletteItem) => {\n    const payload: DragPayload = { type: \"palette\", item };\n    setDragPayload(payload);\n    try {\n      e.dataTransfer.setData(\"application/json\", JSON.stringify(payload));\n      e.dataTransfer.setData(\"text/plain\", JSON.stringify(payload));\n      e.dataTransfer.effectAllowed = \"copy\";\n    } catch {}\n  };\n\n  // Workspace Block Drag handlers\n  const handleBlockDragStart = (e: React.DragEvent, id: string) => {\n    e.stopPropagation();\n    const payload: DragPayload = { type: \"block\", id };\n    setDragPayload(payload);\n    try {\n      e.dataTransfer.setData(\"application/json\", JSON.stringify(payload));\n      e.dataTransfer.setData(\"text/plain\", JSON.stringify(payload));\n      e.dataTransfer.effectAllowed = \"move\";\n    } catch {}\n  };\n\n  const handleDragEnd = () => {\n    setDragPayload(null);\n    setActiveDropTarget(null);\n  };\n\n  // Drag over target container slot\n  const handleDragOver = (e: React.DragEvent, containerKey: string, index: number) => {\n    e.preventDefault();\n    e.stopPropagation();\n    try {\n      e.dataTransfer.dropEffect = dragPayload?.type === \"palette\" ? \"copy\" : \"move\";\n    } catch {}\n    const targetKey = `${containerKey}:${index}`;\n    if (activeDropTarget !== targetKey) {\n      setActiveDropTarget(targetKey);\n    }\n  };\n\n  // Drop into target container slot\n  const handleDrop = (e: React.DragEvent, containerKey: string, index: number) => {\n    e.preventDefault();\n    e.stopPropagation();\n    setActiveDropTarget(null);\n\n    let payload = dragPayload;\n    if (!payload) {\n      try {\n        const raw = e.dataTransfer.getData(\"application/json\") || e.dataTransfer.getData(\"text/plain\");\n        if (raw) payload = JSON.parse(raw);\n      } catch {}\n    }\n    setDragPayload(null);\n\n    if (!payload) return;\n\n    if (payload.type === \"palette\") {\n      const defaultCond = conditions[0]?.id;\n      const newBlock = fromPalette(payload.item, defaultCond);\n      onChange(insertAt(program, containerKey, index, newBlock));\n    } else if (payload.type === \"block\") {\n      onChange(moveBlock(program, payload.id, containerKey, index));\n    }\n  };\n\n  // Click to add from palette directly\n  const handleAddPalette = (item: PaletteItem) => {\n    const defaultCond = conditions[0]?.id;\n    onChange([...program, fromPalette(item, defaultCond)]);\n  };\n\n  // Click to add directly into nested IF slot\n  const handleAddPutToSlot = (ifId: string, slot: \"then\" | \"else\", boxId: string) => {\n    const newBlock: Block = { id: newId(), type: \"put\", box: boxId };\n    const ifBlock = program.find((b) => b.id === ifId);\n    const currentLength = ifBlock && ifBlock.type === \"if\" ? ifBlock[slot].length : 0;\n    onChange(insertAt(program, `${ifId}:${slot}`, currentLength, newBlock));\n  };\n\n  const handleUpdateCond = (ifId: string, newCond: string) => {\n    onChange(updateBlock(program, ifId, { cond: newCond }));\n  };\n\n  return (\n    <div className=\"flex flex-col h-full gap-4 relative select-none\">\n      {/* Workspace */}\n      <div \n        className=\"flex-1 bg-peach/30 border-2 border-navy/10 rounded-2xl p-4 overflow-y-auto flex flex-col min-h-[320px]\"\n        onDragOver={(e) => handleDragOver(e, \"root\", program.length)}\n        onDrop={(e) => handleDrop(e, \"root\", program.length)}\n      >\n        {program.length === 0 ? (\n          <div \n            onDragOver={(e) => handleDragOver(e, \"root\", 0)}\n            onDrop={(e) => handleDrop(e, \"root\", 0)}\n            className={`m-auto w-full max-w-sm rounded-2xl border-2 border-dashed p-8 text-center transition-all ${\n              activeDropTarget === \"root:0\" || activeDropTarget === `root:${program.length}`\n                ? \"border-sky-500 bg-sky-100/70 scale-105 shadow-inner\"\n                : \"border-navy/20 bg-white/40\"\n            }`}\n          >\n            <span className=\"text-4xl block mb-2\">📥</span>\n            <p className=\"font-bold text-navy text-sm\">\n              Tarik blok dari bawah atau klik untuk menambahkan ke sini.\n            </p>\n            <p className=\"text-xs text-ink/70 mt-1\">\n              {isSortBoard\n                ? \"Tarik blok '🔀 Jika' ke sini untuk membuat aturan sortir!\"\n                : \"Tarik blok Gerak / Ulangi untuk menggerakkan rubah!\"}\n            </p>\n          </div>\n        ) : (\n          <div className=\"flex flex-col\">\n            <BlockList \n              blocks={program} \n              containerKey=\"root\" \n              program={program} \n              onChange={onChange}\n              draggedBlockId={dragPayload?.type === \"block\" ? dragPayload.id : null}\n              onDragStart={handleBlockDragStart}\n              onDragEnd={handleDragEnd}\n              onDrop={handleDrop}\n              onDragOver={handleDragOver}\n              activeDropTarget={activeDropTarget}\n              boxes={boxes}\n              conditions={conditions}\n              onAddPutToSlot={handleAddPutToSlot}\n              onUpdateCond={handleUpdateCond}\n            />\n\n            {/* Bottom-most Drop Zone */}\n            <DropZone\n              containerKey=\"root\"\n              index={program.length}\n              activeDropTarget={activeDropTarget}\n              onDragOver={handleDragOver}\n              onDrop={handleDrop}\n              hint={dragPayload ? \"⬇️ Lepas di paling bawah\" : undefined}\n            />\n          </div>\n        )}\n      </div>\n\n      {/* Palette */}\n      <div className=\"bg-white rounded-2xl border-2 border-navy/10 p-4 shadow-sm\">\n        <div className=\"flex items-center justify-between mb-2.5\">\n          <h3 className=\"text-xs font-bold text-navy/70 uppercase tracking-wider flex items-center gap-1.5\">\n            <span>🧩</span> Pilihan Blok (Bisa Diseret / Diklik):\n          </h3>\n          <span className=\"text-[11px] text-ink/60 font-medium hidden sm:inline\">\n            Tahan & seret ke area atas, atau klik langsung\n          </span>\n        </div>\n\n        <div className=\"flex flex-wrap gap-2\">\n          {palette.map((item, i) => {\n            let label = \"\";\n            let icon = \"\";\n            let colorClass = \"bg-sky hover:bg-sky-700\";\n\n            if (item.type === \"move\") {\n              const arrows: Record<string, string> = { up: \"⬆️\", down: \"⬇️\", left: \"⬅️\", right: \"➡️\" };\n              const dirs: Record<string, string> = { up: \"Atas\", down: \"Bawah\", left: \"Kiri\", right: \"Kanan\" };\n              label = `Gerak ${dirs[item.dir]}`;\n              icon = arrows[item.dir];\n              colorClass = \"bg-orange hover:bg-orange-600\";\n            } else if (item.type === \"repeat\") {\n              label = `Ulangi ${item.times ?? 2}x`;\n              icon = \"🔁\";\n              colorClass = \"bg-leaf hover:bg-leaf-700\";\n            } else if (item.type === \"if\") {\n              const condObj = item.cond ? getCondInfo(item.cond) : conditions[0];\n              label = condObj ? `Jika ${condObj.label}` : \"Jika...\";\n              icon = \"🔀\";\n              colorClass = \"bg-sky-600 hover:bg-sky-700\";\n            } else if (item.type === \"put\") {\n              const box = getBoxInfo(item.box);\n              label = box ? `Masukkan ke ${box.label}` : `Kotak ${item.box}`;\n              icon = box?.emoji || \"📥\";\n              if (box?.color === \"blue\") colorClass = \"bg-blue-600 hover:bg-blue-700\";\n              else if (box?.color === \"red\") colorClass = \"bg-rose-600 hover:bg-rose-700\";\n              else if (box?.color === \"green\") colorClass = \"bg-emerald-600 hover:bg-emerald-700\";\n              else if (box?.color === \"yellow\") colorClass = \"bg-amber-600 hover:bg-amber-700\";\n              else colorClass = \"bg-sun hover:bg-yellow-500 text-navy\";\n            }\n\n            return (\n              <div\n                key={i}\n                draggable={true}\n                onDragStart={(e) => handlePaletteDragStart(e, item)}\n                onDragEnd={handleDragEnd}\n                onClick={() => handleAddPalette(item)}\n                className={`px-3.5 py-2.5 rounded-xl text-white font-bold shadow-pop-sm transition-all flex items-center gap-2 cursor-grab active:cursor-grabbing hover:scale-105 active:scale-95 text-xs sm:text-sm ${colorClass}`}\n                title=\"Tahan untuk menyeret ke atas, atau klik langsung!\"\n              >\n                <span className=\"text-base pointer-events-none\">{icon}</span>\n                <span className=\"pointer-events-none\">{label}</span>\n                <span className=\"text-[10px] opacity-60 font-mono pointer-events-none\">⋮⋮</span>\n              </div>\n            );\n          })}\n        </div>\n      </div>\n    </div>\n  );\n}\n\nfunction DropZone({\n  containerKey,\n  index,\n  activeDropTarget,\n  onDragOver,\n  onDrop,\n  hint,\n}: {\n  containerKey: string;\n  index: number;\n  activeDropTarget: string | null;\n  onDragOver: (e: React.DragEvent, key: string, idx: number) => void;\n  onDrop: (e: React.DragEvent, key: string, idx: number) => void;\n  hint?: string;\n}) {\n  const isTarget = activeDropTarget === `${containerKey}:${index}`;\n\n  return (\n    <div\n      onDragOver={(e) => onDragOver(e, containerKey, index)}\n      onDrop={(e) => onDrop(e, containerKey, index)}\n      className={`transition-all duration-150 rounded-xl flex items-center justify-center my-0.5 ${\n        isTarget\n          ? \"h-12 border-2 border-dashed border-sky-500 bg-sky-100/90 scale-[1.01] shadow-inner text-sky-800 font-extrabold text-xs\"\n          : hint\n          ? \"h-9 border-2 border-dashed border-white/30 bg-white/5 hover:border-white/60 text-white/70 text-xs\"\n          : \"h-2 hover:h-6 hover:bg-sky-200/40 opacity-0 hover:opacity-100 rounded-full\"\n      }`}\n    >\n      {isTarget ? (\n        <span>⬇️ Lepas blok di sini</span>\n      ) : hint ? (\n        <span>{hint}</span>\n      ) : null}\n    </div>\n  );\n}\n\nfunction BlockList({\n  blocks,\n  containerKey,\n  program,\n  onChange,\n  draggedBlockId,\n  onDragStart,\n  onDragEnd,\n  onDrop,\n  onDragOver,\n  activeDropTarget,\n  boxes,\n  conditions,\n  onAddPutToSlot,\n  onUpdateCond,\n}: any) {\n  return (\n    <>\n      {blocks.map((b: Block, i: number) => {\n        const box = b.type === \"put\" ? boxes.find((bx: SortBox) => bx.id === b.box) : null;\n        const cond = b.type === \"if\" ? conditions.find((c: SortCondition) => c.id === b.cond) : null;\n\n        return (\n          <div key={b.id} className=\"relative flex flex-col\">\n            {/* Drop zone above each block */}\n            <DropZone\n              containerKey={containerKey}\n              index={i}\n              activeDropTarget={activeDropTarget}\n              onDragOver={onDragOver}\n              onDrop={onDrop}\n            />\n\n            {/* Block Card */}\n            <div\n              draggable={true}\n              onDragStart={(e) => onDragStart(e, b.id)}\n              onDragEnd={onDragEnd}\n              className={`p-3.5 rounded-2xl border-2 border-b-4 border-navy/20 text-white font-bold flex flex-col gap-2.5 transition-all cursor-grab active:cursor-grabbing ${\n                draggedBlockId === b.id ? \"opacity-30 scale-95\" : \"opacity-100 shadow-sm\"\n              } ${getBlockBgColor(b, box)}`}\n            >\n              {/* Header row */}\n              <div className=\"flex justify-between items-center gap-2\">\n                <div className=\"flex items-center gap-2 flex-1 flex-wrap\">\n                  <span className=\"text-xs opacity-60 font-mono\">⋮⋮</span>\n\n                  {b.type === \"move\" && (\n                    <span className=\"text-sm\">\n                      Gerak {b.dir === \"up\" ? \"Atas ⬆️\" : b.dir === \"down\" ? \"Bawah ⬇️\" : b.dir === \"left\" ? \"Kiri ⬅️\" : \"Kanan ➡️\"}\n                    </span>\n                  )}\n                  {b.type === \"repeat\" && <span className=\"text-sm\">🔁 Ulangi {b.times}x</span>}\n                  \n                  {b.type === \"put\" && (\n                    <div className=\"flex items-center gap-1.5 text-sm\">\n                      <span className=\"text-xl\">{box?.emoji || \"📥\"}</span>\n                      <span>Masukkan ke <strong>{box?.label || b.box}</strong></span>\n                    </div>\n                  )}\n\n                  {b.type === \"if\" && (\n                    <div \n                      className=\"flex items-center gap-2 flex-wrap text-sm\"\n                      draggable={false}\n                      onDragStart={(e) => e.stopPropagation()}\n                    >\n                      <span className=\"text-lg\">🔀</span>\n                      <span>JIKA:</span>\n                      {conditions.length > 1 ? (\n                        <select\n                          value={b.cond}\n                          onChange={(e) => onUpdateCond(b.id, e.target.value)}\n                          className=\"bg-white/20 text-white font-extrabold rounded-lg px-2 py-1 text-xs border border-white/40 cursor-pointer focus:outline-none\"\n                        >\n                          {conditions.map((c: SortCondition) => (\n                            <option key={c.id} value={c.id} className=\"text-navy\">\n                              {c.label}\n                            </option>\n                          ))}\n                        </select>\n                      ) : (\n                        <span className=\"bg-white/25 px-2.5 py-1 rounded-lg text-xs font-extrabold text-white\">\n                          {cond?.label || b.cond}\n                        </span>\n                      )}\n                    </div>\n                  )}\n                </div>\n\n                {/* Controls (Move Up, Move Down, Delete) */}\n                <div \n                  className=\"flex gap-1 bg-black/20 rounded-lg p-1 shrink-0\"\n                  draggable={false}\n                  onDragStart={(e) => e.stopPropagation()}\n                >\n                  <button\n                    onClick={() => onChange(nudgeBlock(program, b.id, -1))}\n                    className=\"w-6 h-6 hover:bg-white/30 rounded flex items-center justify-center text-xs cursor-pointer\"\n                    title=\"Geser ke atas\"\n                  >\n                    ⬆️\n                  </button>\n                  <button\n                    onClick={() => onChange(nudgeBlock(program, b.id, 1))}\n                    className=\"w-6 h-6 hover:bg-white/30 rounded flex items-center justify-center text-xs cursor-pointer\"\n                    title=\"Geser ke bawah\"\n                  >\n                    ⬇️\n                  </button>\n                  <button\n                    onClick={() => onChange(removeBlock(program, b.id))}\n                    className=\"w-6 h-6 hover:bg-berry text-berry hover:text-white rounded ml-1 bg-white flex items-center justify-center text-xs cursor-pointer\"\n                    title=\"Hapus blok\"\n                  >\n                    ✕\n                  </button>\n                </div>\n              </div>\n\n              {/* Nested blocks for Repeat */}\n              {b.type === \"repeat\" && (\n                <div \n                  className=\"ml-3 pl-3 border-l-4 border-white/30 min-h-[44px] flex flex-col\"\n                  draggable={false}\n                  onDragStart={(e) => e.stopPropagation()}\n                >\n                  <BlockList\n                    blocks={b.body}\n                    containerKey={`${b.id}:body`}\n                    program={program}\n                    onChange={onChange}\n                    draggedBlockId={draggedBlockId}\n                    onDragStart={onDragStart}\n                    onDragEnd={onDragEnd}\n                    onDrop={onDrop}\n                    onDragOver={onDragOver}\n                    activeDropTarget={activeDropTarget}\n                    boxes={boxes}\n                    conditions={conditions}\n                    onAddPutToSlot={onAddPutToSlot}\n                    onUpdateCond={onUpdateCond}\n                  />\n                  <DropZone\n                    containerKey={`${b.id}:body`}\n                    index={b.body.length}\n                    activeDropTarget={activeDropTarget}\n                    onDragOver={onDragOver}\n                    onDrop={onDrop}\n                    hint={b.body.length === 0 ? \"⬇️ Tarik blok ke dalam pengulangan\" : undefined}\n                  />\n                </div>\n              )}\n\n              {/* Nested blocks for IF (MAKA and JIKA TIDAK) */}\n              {b.type === \"if\" && (\n                <div \n                  className=\"space-y-3 mt-1\"\n                  draggable={false}\n                  onDragStart={(e) => e.stopPropagation()}\n                >\n                  {/* Slot: MAKA */}\n                  <div className=\"bg-white/10 rounded-xl p-2.5 border border-white/20\">\n                    <div className=\"text-xs font-extrabold text-emerald-200 uppercase tracking-wide mb-1 flex items-center gap-1\">\n                      <span>✅</span> MAKA (Jika Ya):\n                    </div>\n                    <div className=\"pl-2 border-l-3 border-emerald-400 min-h-[36px] flex flex-col\">\n                      <BlockList\n                        blocks={b.then}\n                        containerKey={`${b.id}:then`}\n                        program={program}\n                        onChange={onChange}\n                        draggedBlockId={draggedBlockId}\n                        onDragStart={onDragStart}\n                        onDragEnd={onDragEnd}\n                        onDrop={onDrop}\n                        onDragOver={onDragOver}\n                        activeDropTarget={activeDropTarget}\n                        boxes={boxes}\n                        conditions={conditions}\n                        onAddPutToSlot={onAddPutToSlot}\n                        onUpdateCond={onUpdateCond}\n                      />\n                      <DropZone\n                        containerKey={`${b.id}:then`}\n                        index={b.then.length}\n                        activeDropTarget={activeDropTarget}\n                        onDragOver={onDragOver}\n                        onDrop={onDrop}\n                        hint={b.then.length === 0 ? \"⬇️ Tarik blok ke sini\" : undefined}\n                      />\n\n                      {b.then.length === 0 && (\n                        <div className=\"py-1 text-xs text-white/90\">\n                          <span className=\"block mb-1 text-[11px] text-white/70 italic\">\n                            Atau klik cepat:\n                          </span>\n                          <div className=\"flex flex-wrap gap-1.5\">\n                            {boxes.map((bx: SortBox) => (\n                              <button\n                                key={bx.id}\n                                onClick={() => onAddPutToSlot(b.id, \"then\", bx.id)}\n                                className=\"bg-white text-navy font-bold text-xs px-2.5 py-1.5 rounded-lg shadow-sm hover:bg-emerald-50 active:scale-95 flex items-center gap-1 cursor-pointer\"\n                              >\n                                <span>+</span>\n                                <span>{bx.emoji}</span>\n                                <span>{bx.label}</span>\n                              </button>\n                            ))}\n                          </div>\n                        </div>\n                      )}\n                    </div>\n                  </div>\n\n                  {/* Slot: JIKA TIDAK */}\n                  <div className=\"bg-white/10 rounded-xl p-2.5 border border-white/20\">\n                    <div className=\"text-xs font-extrabold text-rose-200 uppercase tracking-wide mb-1 flex items-center gap-1\">\n                      <span>❌</span> JIKA TIDAK (Jika Bukan):\n                    </div>\n                    <div className=\"pl-2 border-l-3 border-rose-400 min-h-[36px] flex flex-col\">\n                      <BlockList\n                        blocks={b.else}\n                        containerKey={`${b.id}:else`}\n                        program={program}\n                        onChange={onChange}\n                        draggedBlockId={draggedBlockId}\n                        onDragStart={onDragStart}\n                        onDragEnd={onDragEnd}\n                        onDrop={onDrop}\n                        onDragOver={onDragOver}\n                        activeDropTarget={activeDropTarget}\n                        boxes={boxes}\n                        conditions={conditions}\n                        onAddPutToSlot={onAddPutToSlot}\n                        onUpdateCond={onUpdateCond}\n                      />\n                      <DropZone\n                        containerKey={`${b.id}:else`}\n                        index={b.else.length}\n                        activeDropTarget={activeDropTarget}\n                        onDragOver={onDragOver}\n                        onDrop={onDrop}\n                        hint={b.else.length === 0 ? \"⬇️ Tarik blok ke sini\" : undefined}\n                      />\n\n                      {b.else.length === 0 && (\n                        <div className=\"py-1 text-xs text-white/90\">\n                          <span className=\"block mb-1 text-[11px] text-white/70 italic\">\n                            Atau klik cepat:\n                          </span>\n                          <div className=\"flex flex-wrap gap-1.5\">\n                            {boxes.map((bx: SortBox) => (\n                              <button\n                                key={bx.id}\n                                onClick={() => onAddPutToSlot(b.id, \"else\", bx.id)}\n                                className=\"bg-white text-navy font-bold text-xs px-2.5 py-1.5 rounded-lg shadow-sm hover:bg-rose-50 active:scale-95 flex items-center gap-1 cursor-pointer\"\n                              >\n                                <span>+</span>\n                                <span>{bx.emoji}</span>\n                                <span>{bx.label}</span>\n                              </button>\n                            ))}\n                          </div>\n                        </div>\n                      )}\n                    </div>\n                  </div>\n                </div>\n              )}\n            </div>\n          </div>\n        );\n      })}\n    </>\n  );\n}\n\nfunction getBlockBgColor(b: Block, box?: SortBox | null) {\n  if (b.type === \"move\") return \"bg-orange hover:bg-orange-600\";\n  if (b.type === \"repeat\") return \"bg-leaf hover:bg-leaf-700\";\n  if (b.type === \"if\") return \"bg-sky-700 hover:bg-sky-800\";\n  if (b.type === \"put\") {\n    if (box?.color === \"blue\") return \"bg-blue-600 hover:bg-blue-700\";\n    if (box?.color === \"red\") return \"bg-rose-600 hover:bg-rose-700\";\n    if (box?.color === \"green\") return \"bg-emerald-600 hover:bg-emerald-700\";\n    if (box?.color === \"yellow\") return \"bg-amber-600 hover:bg-amber-700\";\n    return \"bg-sun hover:bg-yellow-500 text-navy\";\n  }\n  return \"bg-navy\";\n}\n","Description":"Make palette items and workspace blocks fully draggable with visual dropzone targets and click fallbacks","Overwrite":true,"TargetFile":"e:\\codekids\\src\\components\\mission\\BlockEditor.tsx","toolAction":"Overhauling BlockEditor drag-and-drop","toolSummary":"Overhaul drag-and-drop in BlockEditor.tsx"}}]}
