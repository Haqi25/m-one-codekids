{"step_index":627,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-13T14:13:59Z","input_tokens":3743,"cache_read_tokens":129113,"output_tokens":977,"tool_calls":[{"name":"write_to_file","args":{"CodeContent":"\"use client\";\n\n// Web Speech API text-to-speech helper for Bibi AI (FR-AI-06).\n// Allows children with emerging literacy to hear Bibi's guidance out loud.\n\nimport { useState, useEffect } from \"react\";\n\nexport function isSpeechSupported(): boolean {\n  return typeof window !== \"undefined\" && \"speechSynthesis\" in window;\n}\n\n/**\n * React hook to safely check speech synthesis support without SSR hydration mismatch.\n */\nexport function useSpeechSupported(): boolean {\n  const [supported, setSupported] = useState(false);\n\n  useEffect(() => {\n    setSupported(isSpeechSupported());\n  }, []);\n\n  return supported;\n}\n\nexport function cleanTextForSpeech(text: string): string {\n  return text\n    // Remove markdown formatting\n    .replace(/[*_#`~>]/g, \"\")\n    // Remove URLs\n    .replace(/https?:\\/\\/\\S+/g, \"\")\n    // Remove emojis so the speech engine doesn't read out emoji descriptions\n    .replace(/[\\u{1F300}-\\u{1F9FF}\\u{1FA00}-\\u{1FAFF}\\u{2600}-\\u{26FF}\\u{2700}-\\u{27BF}]/gu, \"\")\n    // Remove leftover symbols and collapse whitespace\n    .replace(/\\s+/g, \" \")\n    .trim();\n}\n\nlet activeUtterance: SpeechSynthesisUtterance | null = null;\n\nexport function stopSpeaking() {\n  if (typeof window !== \"undefined\" && \"speechSynthesis\" in window) {\n    try {\n      window.speechSynthesis.cancel();\n    } catch {\n      // Ignore cancel errors\n    }\n  }\n  activeUtterance = null;\n}\n\nexport function speakBibiText(\n  text: string,\n  callbacks?: {\n    onStart?: () => void;\n    onEnd?: () => void;\n    onError?: (err: unknown) => void;\n  }\n) {\n  if (!isSpeechSupported()) {\n    callbacks?.onEnd?.();\n    return;\n  }\n\n  stopSpeaking();\n\n  const cleaned = cleanTextForSpeech(text);\n  if (!cleaned) {\n    callbacks?.onEnd?.();\n    return;\n  }\n\n  const utterance = new SpeechSynthesisUtterance(cleaned);\n  activeUtterance = utterance;\n\n  // Mascot voice personality: friendly, cheerful, slightly higher pitch, gentle pacing for kids\n  utterance.pitch = 1.15;\n  utterance.rate = 0.95;\n\n  const voices = window.speechSynthesis.getVoices();\n  const idVoice = voices.find(\n    (v) =>\n      v.lang.toLowerCase().startsWith(\"id\") ||\n      v.lang.toLowerCase().includes(\"id-id\") ||\n      v.name.toLowerCase().includes(\"indonesia\")\n  );\n\n  if (idVoice) {\n    utterance.voice = idVoice;\n    utterance.lang = idVoice.lang;\n  } else {\n    utterance.lang = \"id-ID\";\n  }\n\n  utterance.onstart = () => {\n    callbacks?.onStart?.();\n  };\n\n  utterance.onend = () => {\n    if (activeUtterance === utterance) {\n      activeUtterance = null;\n    }\n    callbacks?.onEnd?.();\n  };\n\n  utterance.onerror = (e) => {\n    if (activeUtterance === utterance) {\n      activeUtterance = null;\n    }\n    callbacks?.onError?.(e);\n  };\n\n  try {\n    window.speechSynthesis.speak(utterance);\n  } catch (err) {\n    callbacks?.onError?.(err);\n  }\n}\n","Description":"Add useSpeechSupported hook to speech.ts","Overwrite":true,"TargetFile":"e:/codekids/src/lib/speech.ts","toolAction":"Updating speech.ts","toolSummary":"Speech hook addition"}}]}
