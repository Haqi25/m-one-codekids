rofile[]\n37:   createdAt DateTime       @default(now())\n38: }\n39: \n40: /// Minimal child data (NFR-SC-01): nickname, avatar, grade only.\n41: model ChildProfile {\n42:   id            String      @id @default(cuid())\n43:   nickname      String\n44:   avatar        String\n45:   grade         Int\n46:   pinHash       String\n47:   parentId      String?\n48:   parent        User?       @relation(fields: [parentId], references: [id], onDelete: Cascade)\n49:   classId       String?\n50:   class         Class?      @relation(fields: [classId], references: [id], onDelete: Cascade)\n51:   consentAt     DateTime?\n52:   dailyLimitMin Int? // null = no limit\n53:   soundOn       Boolean     @default(true)\n54:   onboarded     Boolean     @default(false)\n55:   lastActiveAt  DateTime?\n56:   createdAt     DateTime    @default(now())\n57:   progress      Progress[]\n58:   attempts      Attempt[]\n59:   badges        ChildBadge[]\n60:   chats         ChatLog[]\n61: }\n62: \n63: model Progress {\n64:   id          String       @id @default(cuid())\n65:   childId     String\n66:   child       ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)\n67:   missionId   String\n68:   completed   Boolean      @default(false)\n69:   stars       Int          @default(0)\n70:   bestScore   Int          @default(0)\n71:   bestBlocks  Int?\n72:   attempts    Int          @default(0)\n73:   hintsUsed   Int          @default(0)\n74:   completedAt DateTime?\n75:   updatedAt   DateTime     @updatedAt\n76: \n77:   @@unique([childId, missionId])\n78: }\n79: \n80: model Attempt {\n81:   id          String       @id @default(cuid())\n82:   childId     String\n83:   child       ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)\n84:   missionId   String\n85:   success     Boolean\n86:   blocksUsed  Int\n87:   hintsUsed   Int          @default(0)\n88:   stars       Int          @default(0)\n89:   score       Int          @default(0)\n90:   durationSec Int          @default(0)\n91:   createdAt   DateTime     @default(now())\n92: \n93:   @@index([childId, createdAt])\n94: }\n95: \n96: model ChildBadge {\n97:   id       String       @id @default(cuid())\n98:   childId  String\n99:   child    ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)\n100:   badgeId  String\n101:   earnedAt DateTime     @default(now())\n102: \n103:   @@unique([childId, badgeId])\n104: }\n105: \n106: model ChatLog {\n107:   id        String       @id @default(cuid())\n108:   childId   String\n109:   child     ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)\n110:   missionId String\n111:   role      String // \"child\" | \"bibi\"\n112:   content   String\n113:   hintLevel Int          @default(0)\n114:   flagged   Boolean      @default(false)\n115:   rating    Int? // 1 = 👍, -1 = 👎\n116:   createdAt DateTime     @default(now())\n117: \n118:   @@index([childId, missionId, createdAt])\n119: }\n120: \n121: \nThe above content shows the entire, complete file contents of the requested file.\n"}
