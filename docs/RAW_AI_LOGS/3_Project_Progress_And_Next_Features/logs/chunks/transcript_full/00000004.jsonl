ems-center justify-center rounded-xl text-3xl ${isWall ? 'bg-navy/5' : 'bg-peach-200/50 border-2 border-peach-300'}`}>\n89:             {isGoal && <span className=\"absolute opacity-50 z-0\">{board.goal.emoji}</span>}\n90:             {isWall && <span className=\"z-10\">{isWall.emoji || \"🧱\"}</span>}\n91:             {item && !isCollected && <span className=\"z-10\">{item.emoji}</span>}\n92:             \n93:             {/* Player Character */}\n94:             {f.pos.x === x && f.pos.y === y && (\n95:               <span className={`absolute z-20 transition-transform duration-500 text-4xl ${f.event === 'bump' || f.event === 'wrong-order' ? 'animate-shake' : ''} ${f.event === 'goal' ? 'animate-bounce-soft' : ''}`}>\n96:                 🦊\n97:               </span>\n98:             )}\n99:           </div>\n100:         );\n101:       })}\n102:     </div>\n103:   );\n104: }\n105: \n106: function SortView({ board, frames, currentIdx }: { board: SortBoard, frames: SortFrame[], currentIdx: number }) {\n107:   // Simple visualization for sort board: show items at top, moving into boxes at bottom\n108:   return (\n109:     <div className=\"flex flex-col h-full w-full justify-between items-center gap-8 py-4\">\n110:       {/* Items queue */}\n111:       <div className=\"flex gap-2 bg-white/50 p-3 rounded-full overflow-x-auto max-w-full\">\n112:         {board.items.map((item, i) => {\n113:           const frame = frames.find(f => f.itemIndex === i);\n114:           const isProcessing = currentIdx >= frames.findIndex(f => f.itemIndex === i) && frame === undefined; // approximate logic for demo\n115:           const isDone = frame !== undefined && frames.indexOf(frame) <= currentIdx;\n116:           return (\n117:              <div key={i} className={`text-4xl transition-all duration-300 ${isDone ? 'scale-0 opacity-0 w-0' : 'scale-100 opacity-100'} ${isProcessing ? 'animate-bounce-soft' : ''}`}>\n118:                {item.emoji}\n119:              </div>\n120:           );\n121:         })}\n122:       </div>\n123:       \n124:       {/* Boxes */}\n125:       <div className=\"flex gap-4 w-full justify-center\">\n126:         {board.boxes.map(box => {\n127:           // Find if the currently processed item is dropped here\n128:           const currentFrame = frames[currentIdx];\n129:           const isDroppedHere = currentFrame?.box === box.id;\n130:           \n131:           return (\n132:             <div key={box.id} className={`flex flex-col items-center gap-2 p-4 rounded-2xl border-4 transition-colors ${isDroppedHere ? (currentFrame.correct ? 'bg-leaf/20 border-leaf' : 'bg-berry/20 border-berry animate-shake') : 'bg-white border-navy/10'}`}>\n133:                <span className=\"text-4xl\">{box.emoji}</span>\n134:                <span className=\"font-bold text-navy text-sm text-center max-w-[100px] leading-tight\">{box.label}</span>\n135:                {/* Show accumulated items */}\n136:                <div className=\"flex flex-wrap gap-1 mt-2 justify-center max-w-[120px]\">\n137:                  {frames.slice(0, currentIdx + 1).filter(f => f.box === box.id).map(f => (\n138:                     <span key={f.itemIndex} className=\"text-xl\">{board.items[f.itemIndex].emoji}</span>\n139:                  ))}\n140:                </div>\n141:             </div>\n142:           )\n143:         })}\n144:       </div>\n145:     </div>\n146:   );\n147: }\n148: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
