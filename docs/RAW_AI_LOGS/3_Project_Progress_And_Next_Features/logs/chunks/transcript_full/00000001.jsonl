sabled={isUpdating} className=\"sr-only peer\" />\n79:           <div className=\"w-11 h-6 bg-peach rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-leaf-700\"></div>\n80:         </label>\n81:       </div>\n82: \n83:       <div className=\"pt-4 border-t border-peach flex flex-wrap gap-4\">\n84:         <button onClick={handleResetPin} className=\"btn-ghost border border-peach text-sm\">\n85:           Reset PIN\n86:         </button>\n87:         <a href={`/api/export/anak/${child.id}`} download className=\"btn-ghost border border-peach text-sm inline-block\">\n88:           Export Data JSON\n89:         </a>\n90:         {isParent && (\n91:           <button onClick={handleDelete} disabled={isDeleting} className=\"btn-ghost text-orange-700 border border-orange-700/30 text-sm\">\n92:             {isDeleting ? \"Menghapus...\" : \"Hapus Data Anak\"}\n93:           </button>\n94:         )}\n95:       </div>\n96:     </div>\n97:   );\n98: }\n99: \nThe above content shows the entire, complete file contents of the requested file.\n"}
