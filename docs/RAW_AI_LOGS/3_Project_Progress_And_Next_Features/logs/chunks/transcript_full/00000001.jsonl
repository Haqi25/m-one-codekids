te: \"lax\" as const,\n42:   secure: process.env.NODE_ENV === \"production\",\n43:   path: \"/\",\n44:   maxAge,\n45: });\n46: \n47: /* ------------------------------ Adult ------------------------------ */\n48: \n49: export type Role = \"PARENT\" | \"TEACHER\";\n50: \n51: export async function createAdultSession(userId: string, role: Role) {\n52:   const jar = await cookies();\n53:   jar.set(ADULT_COOKIE, await sign({ sub: userId, role }, ADULT_TTL), cookieOpts(ADULT_TTL));\n54: }\n55: \n56: export async function getAdultSession() {\n57:   const jar = await cookies();\n58:   const p = await verify<{ sub: string; role: Role }>(jar.get(ADULT_COOKIE)?.value);\n59:   return p ? { userId: p.sub, role: p.role } : null;\n60: }\n61: \n62: export async function requireAdult() {\n63:   const s = await getAdultSession();\n64:   if (!s) redirect(\"/akun/masuk\");\n65:   const user = await db.user.findUnique({ where: { id: s.userId } });\n66:   if (!user) redirect(\"/akun/masuk\");\n67:   return user;\n68: }\n69: \n70: export async function clearAdultSession() {\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
