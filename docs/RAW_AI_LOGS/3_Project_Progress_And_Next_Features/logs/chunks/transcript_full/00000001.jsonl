i?: string })[];\n45:   items: GridItem[];\n46:   /** Optional counter shown while running, e.g. \"Apel\" for multiplication. */\n47:   counterLabel?: string;\n48:   /** Background theme emoji used for decoration. */\n49:   theme?: string;\n50: }\n51: \n52: export interface SortCondition {\n53:   id: string;\n54:   /** Text shown inside the IF block, e.g. \"bilangan genap\". */\n55:   label: string;\n56: }\n57: \n58: export interface SortBox {\n59:   id: string;\n60:   label: string;\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
