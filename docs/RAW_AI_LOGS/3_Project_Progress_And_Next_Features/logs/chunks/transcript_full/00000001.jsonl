{"step_index":57,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-13T02:31:41Z","content":"Created At: 2026-10-13T09:31:41+07:00\nCompleted At: 2026-10-13T09:31:42+07:00\nFile Path: `file:///e:/codekids/src/app/dashboard/anak/%5Bid%5D/page.tsx`\nTotal Lines: 184\nTotal Bytes: 8089\nShowing lines 1 to 100\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import { requireAdult, adultCanAccessChild } from \"@/lib/session\";\n2: import { db } from \"@/lib/db\";\n3: import { totals, rankFor, conceptMastery, BADGES } from \"@/lib/missions/gamification\";\n4: import { MISSIONS, getMission } from \"@/content/missions\";\n5: import { notFound } from \"next/navigation\";\n6: import ActivityChart from \"@/components/dashboard/ActivityChart\";\n7: import ChildSettings from \"@/components/dashboard/ChildSettings\";\n8: import Link from \"next/link\";\n9: \n10: export default async function AnakDetailPage({ params }: { params: Promise<{ id: string }> }) {\n11:   const { id } = await params;\n12:   const user = await requireAdult();\n13:   const access = await adultCanAccessChild(user.id, id);\n14:   if (!access) notFound();\n15: \n16:   const child = await db.childProfile.findUnique({\n17:     where: { id },\n18:     include: {\n19:       progress: true,\n20:       attempts: {\n21:         where: { createdAt: { gte: new Date(Date.now() - 28 * 24 * 60 * 60 * 1000) } }\n22:       },\n23:       chats: {\n24:         orderBy: { createdAt: \"asc\" }\n25:       }\n26:     }\n27:   });\n28: \n29:   if (!child) notFound();\n30: \n31:   const isParent = child.parentId === user.id;\n32:   const stats = totals(child.progress);\n33:   const rank = rankFor(stats.stars);\n34: \n35:   const attempts7d = child.attempts.filter(a => a.createdAt >= new Date(Date.now() - 7 * 24 * 60 * 60 * 1000));\n36:   const weeklyTime = attempts7d.reduce((sum, a) => sum + a.durationSec, 0);\n37: \n38:   const concepts = [\"Sequencing\", \"Looping\", \"IF-ELSE\"] as const;\n39: \n40:   const chatByMission = child.chats.reduce((acc, chat) => {\n41:     if (!acc[chat.missionId]) acc[chat.missionId] = { count: 0, flags: 0, hints: new Set() };\n42:     if (chat.role === \"child\") acc[chat.missionId].count++;\n43:     if (chat.flagged) acc[chat.missionId].flags++;\n44:     if (chat.hintLevel > 0) acc[chat.missionId].hints.add(chat.hintLevel);\n45:     return acc;\n46:   }, {} as Record<string, { count: number; flags: number; hints: Set<number> }>);\n47: \n48:   return (\n49:     <div className=\"space-y-8\">\n50:       <div className=\"flex items-center gap-4 border-b border-peach pb-4\">\n51:         <Link href={isParent ? \"/dashboard\" : `/dashboard/kelas/${child.classId}`} className=\"btn-ghost px-2\">← Kembali</Link>\n52:         <div className=\"text-5xl\">{child.avatar}</div>\n53:         <div>\n54:           <h1 className=\"text-3xl font-display text-navy\">{child.nickname}</h1>\n55:           <div className=\"text-ink\">Kelas {child.grade}</div>\n56:         </div>\n57:       </div>\n58: \n59:       {/* Summary Cards */}\n60:       <div className=\"grid grid-cols-2 md:grid-cols-5 gap-4\">\n61:         <div className=\"card text-center py-4\">\n62:           <div className=\"text-sm text-ink mb-1\">Bintang</div>\n63:           <div className=\"text-2xl font-bold text-orange-700\">⭐ {stats.stars}</div>\n64:         </div>\n65:         <div className=\"card text-center py-4\">\n66:           <div className=\"text-sm text-ink mb-1\">Skor Total</div>\n67:           <div className=\"text-2xl font-bold text-leaf-700\">🏆 {stats.score}</div>\n68:         </div>\n69:         <div className=\"card text-center py-4\">\n70:           <div className=\"text-sm text-ink mb-1\">Level Saat Ini</div>\n71:           <div className=\"text-2xl font-bold text-navy\">{Math.max(1, ...child.progress.filter(p => p.completed).map(p => {\n72:             const m = getMission(p.missionId);\n73:             return m ? m.level : 1;\n74:           }), 1)}</div>\n75:         </div>\n76:         <div className=\"card text-center py-4\">\n77:           <div className=\"text-sm text-ink mb-1\">Peringkat</div>\n78:           <div className=\"text-2xl font-bold text-navy\">{rank.title}</div>\n79:         </div>\n80:         <div className=\"card text-center py-4\">\n81:           <div className=\"text-sm text-ink mb-1\">Waktu (7 Hari)</div>\n82:           <div className=\"text-2xl font-bold text-navy\">{Math.round(weeklyTime / 60)} mnt</div>\n83:         </div>\n84:       </div>\n85: \n86:       {/* Concept Mastery */}\n87:       <div className=\"card\">\n88:         <h2 className=\"text-xl font-display text-navy mb-4\">Penguasaan Konsep</h2>\n89:         <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n90:           {concepts.map(concept => {\n91:             const level = conceptMastery(concept as any, child.progress, child.attempts);\n92:             let label = \"Belum Mulai\";\n93:             let icon = \"⚪\";\n94:             if (level === \"mastered\") { label = \"Sudah Paham\"; icon = \"✅\"; }\n95:             else if (level === \"learning\") { label = \"Sedang Belajar\"; icon = \"⏳\"; }\n96:             else if (level === \"struggling\") { label = \"Perlu Bantuan\"; icon = \"⚠️\"; }\n97:             \n98:             return (\n99:               <div key={concept} className=\"bg-peach/30 p-4 rounded-xl flex items-center gap-3\">\n100:                 <div className=\"text-2xl\">{icon}</div>\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
