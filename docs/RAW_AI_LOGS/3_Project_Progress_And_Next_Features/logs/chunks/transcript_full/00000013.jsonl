nction clearChildSession() {\n96:   (await cookies()).delete(CHILD_COOKIE);\n97: }\n98: \n99: /** Can this adult view/manage this child? (RBAC, NFR-SC-03) */\n100: export async function adultCanAccessChild(userId: string, childId: string) {\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
