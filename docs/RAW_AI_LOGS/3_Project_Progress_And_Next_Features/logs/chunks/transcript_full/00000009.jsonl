      const res = await fetch(\"/api/bibi\", {\n46:         method: \"POST\",\n47:         headers: { \"Content-Type\": \"application/json\" },\n48:         body: JSON.stringify({\n49:           missionId,\n50:           goal,\n51:           program,\n52:           attempts,\n53:           message: text,\n54:           history: messages.filter(m => m.role !== \"bibi\" || m.content !== \"Halo! Aku Bibi. Butuh bantuan dengan misi ini? 🤔\")\n55:         }),\n56:       });\n57: \n58:       if (!res.ok) throw new Error(\"Gagal mengambil respon\");\n59:       \n60:       const data = await res.json();\n61:       setMessages((prev) => [...prev, { role: \"bibi\", content: data.reply }]);\n62:       \n63:       if (data.isHint) {\n64:         onHintUsed();\n65:       }\n66:     } catch (error) {\n67:       setMessages((prev) => [...prev, { role: \"bibi\", content: \"Maaf, Bibi sedang sibuk. Coba lagi nanti ya! 😟\" }]);\n68:     } finally {\n69:       setIsLoading(false);\n70:     }\n71:   };\n72: \n73:   const quickQuestions = [\n74:     \"Aku bingung mulai dari mana\",\n75:     \"Jelaskan pakai contoh dong\",\n76:     \"Blok mana yang salah?\"\n77:   ];\n78: \n79:   return (\n80:     <div className=\"absolute bottom-4 right-4 w-80 sm:w-96 bg-white rounded-2xl shadow-pop flex flex-col overflow-hidden z-50 border-2 border-navy/10 animate-pop-in\">\n81:       {/* Header */}\n82:       <div className=\"bg-peach px-4 py-3 flex justify-between items-center border-b-2 border-navy/10\">\n83:         <div className=\"flex items-center gap-2\">\n84:           <BibiMascot mood=\"happy\" className=\"w-8 h-8\" />\n85:           <h3 className=\"font-display font-bold text-navy\">Tanya Bibi AI</h3>\n86:         </div>\n87:         <button onClick={onClose} className=\"text-navy-700 hover:text-navy font-bold p-1\">\n88:           ✕\n89:         </button>\n90:       </div>\n91: \n92:       {/* Chat Messages */}\n93:       <div className=\"flex-1 p-4 overflow-y-auto max-h-80 min-h-64 flex flex-col gap-3 bg-peach/5\">\n94:         {messages.map((msg, idx) => (\n95:           <div key={idx} className={`flex ${msg.role === \"user\" ? \"justify-end\" : \"justify-start\"}`}>\n96:             <div className={`p-3 rounded-2xl max-w-[85%] text-sm ${\n97:               msg.role === \"user\" \n98:                 ? \"bg-navy text-white rounded-tr-sm\" \n99:                 : \"bg-white text-navy border-2 border-peach-300 rounded-tl-sm shadow-sm\"\n100:             }`}>\n101:               {msg.content}\n102:             </div>\n103:           </div>\n104:         ))}\n105:         {isLoading && (\n106:           <div className=\"flex justify-start\">\n107:             <div className=\"p-3 rounded-2xl bg-white text-navy border-2 border-peach-300 rounded-tl-sm shadow-sm text-sm flex gap-1\">\n108:               <span className=\"animate-bounce\">.</span><span className=\"animate-bounce\" style={{animationDelay: \"0.2s\"}}>.</span><span className=\"animate-bounce\" style={{animationDelay: \"0.4s\"}}>.</span>\n109:             </div>\n110:           </div>\n111:         )}\n112:         <div ref={messagesEndRef} />\n113:       </div>\n114: \n115:       {/* Quick Questions & Input */}\n116:       <div className=\"p-3 bg-white border-t-2 border-navy/10 flex flex-col gap-2\">\n117:         {messages.length <= 2 && (\n118:           <div className=\"flex flex-wrap gap-2 mb-1\">\n119:             {quickQuestions.map((q) => (\n120:               <button \n121:                 key={q} \n122:                 onClick={() => sendMessage(q)}\n123:                 className=\"text-xs bg-peach-200 hover:bg-peach-300 text-navy-700 px-2 py-1 rounded-full text-left transition-colors\"\n124:               >\n125:                 {q}\n126:               </button>\n127:             ))}\n128:           </div>\n129:         )}\n130:         <form \n131:           onSubmit={(e) => {\n132:             e.preventDefault();\n133:             const form = e.target as HTMLFormElement;\n134:             const input = form.elements.namedItem(\"message\") as HTMLInputElement;\n135:             sendMessage(input.value);\n136:             input.value = \"\";\n137:           }}\n138:           className=\"flex gap-2\"\n139:         >\n140:           <input \n141:             type=\"text\" \n142:             name=\"message\"\n143:             placeholder=\"Tanya ke Bibi...\" \n144:             autoComplete=\"off\"\n145:             className=\"input flex-1 !py-2 !text-sm\"\n146:             disabled={isLoading}\n147:           />\n148:           <button type=\"submit\" disabled={isLoading} className=\"btn-primary !px-3 !py-2 !text-sm\">\n149:             Kirim\n150:           </button>\n151:         </form>\n152:       </div>\n153:     </div>\n154:   );\n155: }\n156: \n157: \nThe above content shows the entire, complete file contents of the requested file.\n"}
