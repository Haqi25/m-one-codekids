{"step_index":626,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-13T14:13:58Z","content":"Created At: 2026-10-13T21:13:58+07:00\nCompleted At: 2026-10-13T21:13:58+07:00\nFile Path: `file:///e:/codekids/src/lib/speech.ts`\nTotal Lines: 102\nTotal Bytes: 2446\nShowing lines 1 to 102\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: // Web Speech API text-to-speech helper for Bibi AI (FR-AI-06).\n2: // Allows children with emerging literacy to hear Bibi's guidance out loud.\n3: \n4: export function isSpeechSupported(): boolean {\n5:   return typeof window !== \"undefined\" && \"speechSynthesis\" in window;\n6: }\n7: \n8: export function cleanTextForSpeech(text: string): string {\n9:   return text\n10:     // Remove markdown formatting\n11:     .replace(/[*_#`~>]/g, \"\")\n12:     // Remove URLs\n13:     .replace(/https?:\\/\\/\\S+/g, \"\")\n14:     // Remove emojis so the speech engine doesn't read out emoji descriptions\n15:     .replace(/[\\u{1F300}-\\u{1F9FF}\\u{1FA00}-\\u{1FAFF}\\u{2600}-\\u{26FF}\\u{2700}-\\u{27BF}]/gu, \"\")\n16:     // Remove leftover symbols and collapse whitespace\n17:     .replace(/\\s+/g, \" \")\n18:     .trim();\n19: }\n20: \n21: let activeUtterance: SpeechSynthesisUtterance | null = null;\n22: \n23: export function stopSpeaking() {\n24:   if (typeof window !== \"undefined\" && \"speechSynthesis\" in window) {\n25:     try {\n26:       window.speechSynthesis.cancel();\n27:     } catch {\n28:       // Ignore cancel errors\n29:     }\n30:   }\n31:   activeUtterance = null;\n32: }\n33: \n34: export function speakBibiText(\n35:   text: string,\n36:   callbacks?: {\n37:     onStart?: () => void;\n38:     onEnd?: () => void;\n39:     onError?: (err: unknown) => void;\n40:   }\n41: ) {\n42:   if (!isSpeechSupported()) {\n43:     callbacks?.onEnd?.();\n44:     return;\n45:   }\n46: \n47:   stopSpeaking();\n48: \n49:   const cleaned = cleanTextForSpeech(text);\n50:   if (!cleaned) {\n51:     callbacks?.onEnd?.();\n52:     return;\n53:   }\n54: \n55:   const utterance = new SpeechSynthesisUtterance(cleaned);\n56:   activeUtterance = utterance;\n57: \n58:   // Mascot voice personality: friendly, cheerful, slightly higher pitch, gentle pacing for kids\n59:   utterance.pitch = 1.15;\n60:   utterance.rate = 0.95;\n61: \n62:   const voices = window.speechSynthesis.getVoices();\n63:   const idVoice = voices.find(\n64:     (v) =>\n65:       v.lang.toLowerCase().startsWith(\"id\") ||\n66:       v.lang.toLowerCase().includes(\"id-id\") ||\n67:       v.name.toLowerCase().includes(\"indonesia\")\n68:   );\n69: \n70:   if (idVoice) {\n71:     utterance.voice = idVoice;\n72:     utterance.lang = idVoice.lang;\n73:   } else {\n74:     utterance.lang = \"id-ID\";\n75:   }\n76: \n77:   utterance.onstart = () => {\n78:     callbacks?.onStart?.();\n79:   };\n80: \n81:   utterance.onend = () => {\n82:     if (activeUtterance === utterance) {\n83:       activeUtterance = null;\n84:     }\n85:     callbacks?.onEnd?.();\n86:   };\n87: \n88:   utterance.onerror = (e) => {\n89:     if (activeUtterance === utterance) {\n90:       activeUtterance = null;\n91:     }\n92:     callbacks?.onError?.(e);\n93:   };\n94: \n95:   try {\n96:     window.speechSynthesis.speak(utterance);\n97:   } catch (err) {\n98:     callbacks?.onError?.(err);\n99:   }\n100: }\n101: \n102: \