{"step_index":130,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-08T14:03:10Z","content":"Created At: 2026-10-08T21:03:10+07:00\nCompleted At: 2026-10-08T21:03:10+07:00\nFile Path: `file:///e:/codekids/src/components/mission/MissionWorkspace.tsx`\nTotal Lines: 128\nTotal Bytes: 5292\nShowing lines 1 to 128\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"use client\";\n2: import { useState } from \"react\";\n3: import type { Mission, Block, RunResult } from \"@/lib/missions/types\";\n4: import { BlockEditor } from \"@/components/mission/BlockEditor\";\n5: import { BoardView } from \"@/components/mission/BoardView\";\n6: import { BibiMascot } from \"@/components/brand/BibiMascot\";\n7: import { feedbackFor } from \"@/lib/missions/engine\";\n8: import Link from \"next/link\";\n9: import { useRouter } from \"next/navigation\";\n10: \n11: // The interactive mission workspace\n12: \n13: export default function MissionWorkspace({ \n14:   mission, \n15:   childId,\n16:   starsToUnlock,\n17: }: { \n18:   mission: Mission; \n19:   childId: string;\n20:   starsToUnlock: number;\n21: }) {\n22:   const router = useRouter();\n23:   const [program, setProgram] = useState<Block[]>([]);\n24:   const [result, setResult] = useState<RunResult | null>(null);\n25:   const [attempts, setAttempts] = useState(0);\n26:   const [isSubmitting, setIsSubmitting] = useState(false);\n27: \n28:   const handleResult = async (res: RunResult) => {\n29:     setResult(res);\n30:     setAttempts(a => a + 1);\n31:     \n32:     // Save attempt (and progress if success) to server via API\n33:     try {\n34:       setIsSubmitting(true);\n35:       const data = new FormData();\n36:       data.append(\"missionId\", mission.id);\n37:       data.append(\"success\", String(res.success));\n38:       data.append(\"blocksUsed\", String(res.blocksUsed));\n39:       data.append(\"hintsUsed\", \"0\"); // TODO: integrate with Bibi chat\n40:       \n41:       const response = await fetch(\"/api/progress\", {\n42:         method: \"POST\",\n43:         body: data,\n44:       });\n45:       if (res.success && response.ok) {\n46:         // We will show a success modal, then route back to map\n47:       }\n48:     } catch (e) {\n49:       console.error(e);\n50:     } finally {\n51:       setIsSubmitting(false);\n52:     }\n53:   };\n54: \n55:   return (\n56:     <div className=\"flex flex-col h-dvh bg-peach overflow-hidden\">\n57:       {/* Top Bar */}\n58:       <header className=\"bg-white px-4 py-3 border-b-2 border-navy/10 flex justify-between items-center z-10 shadow-sm shrink-0\">\n59:         <Link href=\"/peta\" className=\"btn-ghost !min-h-10 px-4 py-2 text-sm\">⬅️ Peta</Link>\n60:         <h1 className=\"font-display font-bold text-navy text-xl text-center flex-1 mx-4 truncate\">\n61:           Misi {mission.order}: {mission.title}\n62:         </h1>\n63:         <div className=\"flex gap-2\">\n64:           {/* Stars indicator */}\n65:           <div className=\"bg-peach-200 text-orange-700 font-bold px-3 py-1.5 rounded-full flex gap-1 items-center\">\n66:              ⭐ <span className=\"hidden sm:inline\">Terkumpul</span>\n67:           </div>\n68:         </div>\n69:       </header>\n70: \n71:       {/* Main Workspace (split layout on desktop, stacked on mobile) */}\n72:       <main className=\"flex-1 flex flex-col md:flex-row overflow-hidden relative\">\n73:         \n74:         {/* Left: Board & Story */}\n75:         <section className=\"w-full md:w-5/12 lg:w-1/2 flex flex-col border-b-2 md:border-b-0 md:border-r-2 border-navy/10 bg-white\">\n76:            <div className=\"p-4 md:p-6 bg-peach-200/30 text-navy text-lg leading-relaxed flex items-start gap-4\">\n77:               <BibiMascot className=\"w-16 h-16 shrink-0\" mood={result?.success ? \"cheer\" : \"happy\"} />\n78:               <div>\n79:                 <p className=\"font-bold\">{mission.story}</p>\n80:                 <p className=\"text-sm mt-1 bg-white/60 inline-block px-2 py-1 rounded-lg text-navy-700 font-bold\">🎯 Tujuan: {mission.goal}</p>\n81:               </div>\n82:            </div>\n83:            \n84:            <div className=\"flex-1 p-4 md:p-6 overflow-y-auto\">\n85:              <BoardView board={mission.board} program={program} onResult={handleResult} />\n86:              \n87:              {/* Feedback Area */}\n88:              {result && (\n89:                <div className={`mt-6 p-4 rounded-2xl border-2 animate-pop-in ${result.success ? 'bg-leaf/10 border-leaf text-leaf-700' : 'bg-orange/10 border-orange text-orange-700'}`}>\n90:                  <p className=\"font-bold text-lg\">{feedbackFor(result)}</p>\n91:                  {!result.success && (\n92:                    <button className=\"btn-ghost w-full mt-3 flex items-center justify-center gap-2\">\n93:                      Tanya Bibi <BibiMascot className=\"w-6 h-6\" mood=\"thinking\" />\n94:                    </button>\n95:                  )}\n96:                </div>\n97:              )}\n98:            </div>\n99:         </section>\n100: \n101:         {/* Right: Block Editor */}\n102:         <section className=\"w-full md:w-7/12 lg:w-1/2 flex flex-col bg-peach/10 p-4\">\n103:            <BlockEditor \n104:              program={program} \n105:              onChange={setProgram} \n106:              palette={mission.palette} \n107:            />\n108:         </section>\n109: \n110:         {/* Success Overlay */}\n111:         {result?.success && !isSubmitting && (\n112:            <div className=\"absolute inset-0 bg-navy/80 backdrop-blur-sm z-50 flex items-center justify-center p-4\">\n113:              <div className=\"bg-white rounded-[2rem] p-8 max-w-sm w-full text-center shadow-soft animate-pop-in\">\n114:                <BibiMascot className=\"w-32 h-32 mx-auto mb-4\" mood=\"cheer\" />\n115:                <h2 className=\"text-3xl font-display text-navy mb-2\">Misi Berhasil!</h2>\n116:                <div className=\"flex justify-center gap-2 text-4xl mb-6\">\n117:                  {/* TODO: Calculate actual stars based on constraints */}\n118:                  ⭐ ⭐ ⭐\n119:                </div>\n120:                <Link href=\"/peta\" className=\"btn-primary w-full text-xl py-4\">Lanjut Petualangan 🚀</Link>\n121:              </div>\n122:            </div>\n123:         )}\n124:       </main>\n125:     </div>\n126:   );\n127: }\n128: \nThe above content shows the entire, complete file contents of the requested file.\n"}
