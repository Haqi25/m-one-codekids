{"step_index":41,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-07T07:36:30Z","input_tokens":590,"cache_read_tokens":74425,"output_tokens":3929,"content":"Scaffold is still running. Next I'll write the scoring, ranks, badges, and unlock logic as pure functions.","thinking":"I'm moving on to look at the scoring and progress logic, starting with the scoring module.\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import type { Concept } from \"./types\";\n\n/* ------------------------------ Stars & score ------------------------------ */\n\nexport type StarInput = {\n  blocksUsed: number;\n  optimalBlocks: number;\n  /** Failed runs in the current play session before this success. */\n  failedAttempts: number;\n  /** Highest Bibi hint tier used in this play session (0 = no hints). */\n  maxHintTier: number;\n  /** Number of Bibi hints used in this play session. */\n  hintsUsed: number;\n};\n\n/**\n * FR-MISI-06 / FR-AI-07: 1–3 stars based on block efficiency, attempts, and\n * proportional hint usage. Never below 1 star (NFR-UX-04: no punishing screens).\n */\nexport function starPenalty(input: StarInput): number {\n  const over = input.blocksUsed - input.optimalBlocks;\n  const efficiency = over <= 0 ? 0 : over <= 2 ? 0.5 : 1;\n  const attempts = input.failedAttempts >= 6 ? 1 : input.failedAttempts >= 3 ? 0.5 : 0;\n  const tierPenalty = [0, 0.25, 0.5, 1][Math.min(3, Math.max(0, input.maxHintTier))];\n  const extraHints = Math.max(0, input.hintsUsed - 3) * 0.25;\n  const hints = Math.min(1.5, tierPenalty + extraHints);\n  return efficiency + attempts + hints;\n}\n\nexport function computeStars(input: StarInput): 1 | 2 | 3 {\n  const raw = Math.round(3 - starPenalty(input));\n  return Math.min(3, Math.max(1, raw)) as 1 | 2 | 3;\n}\n\nexport function computeScore(input: StarInput, stars: number): number {\n  const efficientBonus = input.blocksUsed <= input.optimalBlocks ? 50 : 0;\n  const noHintBonus = input.hintsUsed === 0 ? 50 : 0;\n  return stars * 100 + efficientBonus + noHintBonus;\n}\n\n/* ---------------------------------- Ranks ---------------------------------- */\n\nexport const RANKS = [\n  { id: \"penjelajah\", name: \"Penjelajah\", minXp: 0, icon: \"🧭\" },\n  { id: \"petualang\", name: \"Petualang\", minXp: 1500, icon: \"🎒\" },\n  { id: \"jagoan\", name: \"Jagoan Kode\", minXp: 3500, icon: \"🏆\" },\n] as const;\n\nexport function rankForXp(xp: number) {\n  let current: (typeof RANKS)[number] = RANKS[0];\n  for (const r of RANKS) if (xp >= r.minXp) current = r;\n  const next = RANKS.find((r) => r.minXp > xp) ?? null;\n  return { current, next };\n}\n\n/* ------------------------------ Level unlocking ---------------------------- */\n\nexport const LEVEL_UNLOCK_RATIO = 0.7;\n\nexport type ProgressLike = {\n  missionId: string;\n  bestStars: number;\n  completed: boolean;\n  totalAttempts: number;\n  totalFailed: number;\n  totalHints: number;\n  maxHintTierEver: number;\n  noHintClear: boolean;\n};\n\nexport type MissionLike = { id: string; level: number; order: number; concept: Concept };\n\nexport function starsNeededForNextLevel(missionsInLevel: number): number {\n  return Math.ceil(missionsInLevel * 3 * LEVEL_UNLOCK_RATIO);\n}\n\nexport type NodeStatus = \"locked\" | \"open\" | \"completed\";\n\nexport type LevelSummary = {\n  level: number;\n  concept: Concept;\n  unlocked: boolean;\n  stars: number;\n  maxStars: number;\n  starsToUnlockNext: number;\n  missions: { id: string; status: NodeStatus; stars: number }[];\n};\n\n/**\n * FR-MISI-01 / FR-MISI-09: world map status. Level N+1 unlocks when ≥ 70% of\n * level N stars are collected. Inside a level, missions open one by one.\n */\nexport function buildMap(missions: MissionLike[], progress: ProgressLike[]): LevelSummary[] {\n  const byId = new Map(progress.map((p) => [p.missionId, p]));\n  const levels = [...new Set(missions.map((m) => m.level))].sort((a, b) => a - b);\n  const result: LevelSummary[] = [];\n  let prevUnlocked = true;\n  let prevReached = true;\n  for (const level of levels) {\n    const ms = missions.filter((m) => m.level === level).sort((a, b) => a.order - b.order);\n    const unlocked = prevUnlocked && prevReached;\n    let previousDone = true;\n    let stars = 0;\n    const nodes = ms.map((m) => {\n      const p = byId.get(m.id);\n      const done = Boolean(p?.completed);\n      const s = p?.bestStars ?? 0;\n      stars += s;\n      const status: NodeStatus = !unlocked ? \"locked\" : done ? \"completed\" : previousDone ? \"open\" : \"locked\";\n      previousDone = done;\n      return { id: m.id, status, stars: s };\n    });\n    const needed = starsNeededForNextLevel(ms.length);\n    result.push({\n      level,\n      concept: ms[0]?.concept ?? \"sequencing\",\n      unlocked,\n      stars,\n      maxStars: ms.length * 3,\n      starsToUnlockNext: needed,\n      missions: nodes,\n    });\n    prevUnlocked = unlocked;\n    prevReached = stars >= needed;\n  }\n  return result;\n}\n\n/** Whether a given mission is playable for the child (server-side guard). */\nexport function isMissionPlayable(missionId: string, map: LevelSummary[]): boolean {\n  for (const l of map) {\n    const node = l.missions.find((m) => m.id === missionId);\n    if (node) return node.status !== \"locked\";\n  }\n  return false;\n}\n\n/* --------------------------------- Badges ---------------------------------- */\n\nexport const BADGES = {\n  \"misi-pertama\": { name: \"Misi Pertama\", icon: \"🚀\", desc: \"Menyelesaikan misi pertama.\" },\n  \"tanpa-petunjuk\": { name: \"Tanpa Petunjuk\", icon: \"🧠\", desc: \"Menyelesaikan 3 misi tanpa bantuan Bibi.\" },\n  \"bintang-tiga\": { name: \"Bintang Tiga\", icon: \"🌟\", desc: \"Mendapat 3 bintang pertama kali.\" },\n  \"master-sequencing\": { name: \"Master Urutan\", icon: \"🧩\", desc: \"Menyelesaikan semua misi Level 1.\" },\n  \"master-looping\": { name: \"Master Looping\", icon: \"🔁\", desc: \"Menyelesaikan semua misi Level 2.\" },\n  \"master-kondisional\": { name: \"Master Kondisional\", icon: \"🔀\", desc: \"Menyelesaikan semua misi Level 3.\" },\n  \"sahabat-bibi\": { name: \"Sahabat Bibi\", icon: \"💬\", desc: \"Bertanya kepada Bibi untuk pertama kali.\" },\n} as const;\n\nexport type BadgeCode = keyof typeof BADGES;\n\nexport function evaluateBadges(\n  missions: MissionLike[],\n  progress: ProgressLike[],\n  opts: { askedBibi: boolean },\n): BadgeCode[] {\n  const earned: BadgeCode[] = [];\n  const done = progress.filter((p) => p.completed);\n  if (done.length >= 1) earned.push(\"misi-pertama\");\n  if (done.filter((p) => p.noHintClear).length >= 3) earned.push(\"tanpa-petunjuk\");\n  if (done.some((p) => p.bestStars >= 3)) earned.push(\"bintang-tiga\");\n  const levelDone = (level: number) => {\n    const ids = missions.filter((m) => m.level === level).map((m) => m.id);\n    return ids.length > 0 && ids.every((id) => done.some((p) => p.missionId === id));\n  };\n  if (levelDone(1)) earned.push(\"master-sequencing\");\n  if (levelDone(2)) earned.push(\"master-looping\");\n  if (levelDone(3)) earned.push(\"master-kondisional\");\n  if (opts.askedBibi) earned.push(\"sahabat-bibi\");\n  return earned;\n}\n\n/* ---------------------------- Concept mastery ------------------------------ */\n\nexport type Mastery = \"sudah-paham\" | \"sedang-belajar\" | \"perlu-bantuan\" | \"belum-mulai\";\n\nexport const MASTERY_LABEL: Record<Mastery, string> = {\n  \"sudah-paham\": \"Sudah Paham\",\n  \"sedang-belajar\": \"Sedang Belajar\",\n  \"perlu-bantuan\": \"Perlu Bantuan\",\n  \"belum-mulai\": \"Belum Mulai\",\n};\n\n/** FR-DASH-03: simple, plain-language mastery indicator per concept. */\nexport function conceptMastery(missions: MissionLike[], progress: ProgressLike[], concept: Concept): Mastery {\n  const ids = new Set(missions.filter((m) => m.concept === concept).map((m) => m.id));\n  const ps = progress.filter((p) => ids.has(p.missionId));\n  const attempts = ps.reduce((a, p) => a + p.totalAttempts, 0);\n  if (attempts === 0) return \"belum-mulai\";\n  const completed = ps.filter((p) => p.completed);\n  const stars = completed.reduce((a, p) => a + p.bestStars, 0);\n  const failed = ps.reduce((a, p) => a + p.totalFailed, 0);\n  const maxStars = ids.size * 3;\n  const failRate = failed / Math.max(1, attempts);\n  if (completed.length === ids.size && stars >= Math.ceil(maxStars * LEVEL_UNLOCK_RATIO)) return \"sudah-paham\";\n  const struggling = ps.some((p) => !p.completed && p.totalFailed >= 5) || (failRate > 0.75 && attempts >= 6);\n  if (struggling) return \"perlu-bantuan\";\n  return \"sedang-belajar\";\n}\n\nexport const CONCEPT_LABEL: Record<Concept, string> = {\n  sequencing: \"Urutan (Sequencing)\",\n  looping: \"Perulangan (Looping)\",\n  conditional: \"Kondisi (IF-ELSE)\",\n};\n","Description":"Pure logic for stars, score, ranks, level unlocking (70%), badges and concept mastery.","Overwrite":false,"TargetFile":"e:\\codekids\\src\\lib\\engine\\scoring.ts","toolAction":"Writing scoring logic","toolSummary":"Scoring and progress logic"}}]}
