m || !world.cards.some((c) => c.id === m[1])) {\n          throw new Halt({\n            kind: \"invalid-program\",\n            blockId,\n            message: \"Ada blok yang tidak dikenal.\",\n            diagnosis: \"Blok tidak dikenal.\",\n          });\n        }\n        const k = state.placed.length;\n        const correct = world.answer[k] === m[1];\n        state.placed.push({ card: m[1], correct });\n        frames.push({ blockId, state: clone(state), variant: 0, bad: !correct });\n        if (!correct) {\n          throw new Halt({\n            kind: \"wrong-order\",\n            blockId,\n            message:\n              k === 0\n                ? `Hmm, apakah \"${cardLabel(m[1])}\" benar-benar langkah pertama?`\n                : `${k} langkah pertama sudah benar! 👍 Tapi \"${cardLabel(m[1])}\" sepertinya belum pas di urutan ke-${k + 1}.`,\n            diagnosis: `Urutan 1 sampai ${k} sudah benar. Kartu ke-${k + 1} (\"${cardLabel(m[1])}\") belum tepat.`,\n          });\n        }\n      },\n      test: () => false,\n    },\n    counter,\n  );\n  if (state.placed.length < world.answer.length) {\n    const left = world.answer.length - state.placed.length;\n    throw new Halt({\n      kind: \"incomplete\",\n      message: `Urutannya sudah benar sejauh ini! Masih kurang ${left} langkah lagi.`,\n      diagnosis: `${state.placed.length} langkah benar, masih kurang ${left} langkah di akhir.`,\n    });\n  }\n}\n\n/* ---------------------------------- Public --------------------------------- */\n\nexport function initialState(world: World, variant = 0): WorldState {\n  switch (world.type) {\n    case \"grid\":\n      return initialGridState(world, variant);\n    case \"numberline\":\n      return { kind: \"numberline\", value: world.start };\n    case \"sort\":\n      return { kind: \"sort\", itemIndex: 0, placed: [] };\n    case \"sequence\":\n      return { kind: \"sequence\", placed: [] };\n  }\n}\n\n/** Run a program against a mission. Pure and deterministic. */\nexport function runProgram(mission: Pick<Mission, \"world\" | \"palette\">, program: Program): RunResult {\n  const frames: Frame[] = [];\n  const blocksUsed = countBlocks(program);\n  let variant = 0;\n  try {\n    if (program.length === 0) {\n      throw new Halt({\n        kind: \"empty\",\n        message: \"Papan programmu masih kosong. Yuk, tarik blok ke sini! 🧩\",\n        diagnosis: \"Program masih kosong.\",\n      });\n    }\n    const invalid = validateProgram(program, mission.palette);\n    if (invalid) {\n      throw new Halt({ kind: \"invalid-program\", message: invalid, diagnosis: invalid });\n    }\n    const w = mission.world;\n    switch (w.type) {\n      case \"grid\":\n        for (variant = 0; variant < w.layouts.length; variant++) {\n          runGridVariant(w, program, variant, frames);\n        }\n        variant = w.layouts.length - 1;\n        break;\n      case \"numberline\":\n        runNumberLine(w, program, frames);\n        break;\n      case \"sort\":\n        runSort(w, program, frames);\n        break;\n      case \"sequence\":\n        runSequence(w, program, frames);\n        break;\n    }\n    return { success: true, frames, blocksUsed };\n  } catch (e) {\n    if (e instanceof Halt) {\n      if (frames.length === 0) frames.push({ state: initialState(mission.world), variant: 0 });\n      frames[frames.length - 1] = { ...frames[frames.length - 1], bad: true };\n      const v = mission.world.type === \"grid\" ? variant : 0;\n      const failure: RunFailure = {\n        ...e.failure,\n        variant: v,\n        diagnosis:\n          mission.world.type === \"grid\" && mission.world.layouts.length > 1\n            ? `[Papan ${v + 1}] ${e.failure.diagnosis}`\n            : e.failure.diagnosis,\n      };\n      return { success: false, frames, blocksUsed, failure };\n    }\n    throw e;\n  }\n}\n\n/** Short textual description of a program, used as context for Bibi. */\nexport function describeProgram(program: Program, palette: Palette, indent = \"\"): string {\n  const actionLabel = (a: string) => palette.actions.find((p) => p.action === a)?.label ?? a;\n  const condLabel = (c: string) => palette.conditions?.find((p) => p.id === c)?.label ?? c;\n  if (program.length === 0) return `${indent}(kosong)`;\n  return program\n    .map((b) => {\n      if (b.kind === \"action\") return `${indent}- ${actionLabel(b.action)}`;\n      if (b.kind === \"repeat\") {\n        return `${indent}- ulangi ${b.times}x:\\n${describeProgram(b.body, palette, indent + \"  \")}`;\n      }\n      return `${indent}- jika ${condLabel(b.cond)}:\\n${describeProgram(b.then, palette, indent + \"  \")}\\n${indent}  lainnya:\\n${describeProgram(b.else, palette, indent + \"  \")}`;\n    })\n    .join(\"\\n\");\n}\n","Description":"Deterministic interpreter for all 4 world types; shared by client animation and server validation.","Overwrite":false,"TargetFile":"e:\\codekids\\src\\lib\\engine\\interpreter.ts","toolAction":"Writing engine interpreter","toolSummary":"Engine interpreter"}}]}
