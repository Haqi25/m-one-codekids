: [\n        { \"action\": \"add:5\", \"label\": \"Lompat +5\", \"icon\": \"🐇\" },\n        { \"action\": \"add:2\", \"label\": \"Lompat +2\", \"icon\": \"👣\" },\n        { \"action\": \"sub:5\", \"label\": \"Mundur −5\", \"icon\": \"⬅️\" }\n      ],\n      \"repeat\": true\n    },\n    \"optimalBlocks\": 2,\n    \"hints\": {\n      \"tier1\": [\n        \"Dari 5 ke 10, lalu ke 15. Setiap kali bertambah berapa? 🔢\",\n        \"Berapa kali kelinci perlu melompat dari 5 sampai 35?\"\n      ],\n      \"tier2\": [\n        \"Seperti menghitung jari tangan lima-lima: 5, 10, 15... Gerakannya selalu sama! 🖐️\",\n        \"Naik tangga yang anak tangganya sama tinggi: cukup bilang 'naik satu anak tangga, ulangi'.\"\n      ],\n      \"tier3\": [\n        \"Lihat angka tempat kelinci berhenti, lalu bandingkan dengan 35. Kurang atau lebih berapa lompatan?\",\n        \"Selisih 35 dan 5 itu 30. Berapa kali lompat +5 untuk mendapat 30?\"\n      ]\n    },\n    \"solution\": [\n      {\n        \"id\": \"s1\",\n        \"kind\": \"repeat\",\n        \"times\": 6,\n        \"body\": [{ \"id\": \"s2\", \"kind\": \"action\", \"action\": \"add:5\" }]\n      }\n    ]\n  },\n  {\n    \"id\": \"L2-M4\",\n    \"level\": 2,\n    \"order\": 4,\n    \"title\": \"Tangga Fase Bulan\",\n    \"subject\": \"IPA\",\n    \"concept\": \"looping\",\n    \"story\": \"Bulan terlihat berubah bentuk setiap minggu. Kumpulkan 4 fase bulan di tangga langit!\",\n    \"goal\": \"Ambil semua 🌙. Cari pola gerakan yang berulang!\",\n    \"world\": {\n      \"type\": \"grid\",\n      \"width\": 5,\n      \"height\": 5,\n      \"start\": { \"x\": 0, \"y\": 4, \"dir\": \"E\" },\n      \"hero\": \"🚀\",\n      \"layouts\": [[\"....I\", \"...I.\", \"..I..\", \".I...\", \".....\"]],\n      \"legend\": { \"I\": \"🌙\" },\n      \"goal\": { \"collectAll\": true }\n    },\n    \"palette\": {\n      \"actions\": [\n        { \"action\": \"forward\", \"label\": \"Maju\", \"icon\": \"⬆️\" },\n        { \"action\": \"turnLeft\", \"label\": \"Belok Kiri\", \"icon\": \"↩️\" },\n        { \"action\": \"turnRight\", \"label\": \"Belok Kanan\", \"icon\": \"↪️\" },\n        { \"action\": \"collect\", \"label\": \"Ambil\", \"icon\": \"✋\" }\n      ],\n      \"repeat\": true\n    },\n    \"optimalBlocks\": 6,\n    \"hints\": {\n      \"tier1\": [\n        \"Coba tulis gerakan untuk bulan pertama saja. Apakah bulan kedua butuh gerakan yang sama? 🌙\",\n        \"Setelah mengambil bulan, roket harus menghadap ke arah mana lagi?\"\n      ],\n      \"tier2\": [\n        \"Tangga itu polanya: maju, naik, maju, naik. Seperti tarian yang gerakannya diulang! 💃\",\n        \"Bulan berganti fase dengan pola yang sama setiap bulan, seperti gerakan roketmu.\"\n      ],\n      \"tier3\": [\n        \"Perhatikan blok yang menyala. Sebelum mengulang, apakah roket sudah menghadap ke arah awal lagi?\",\n        \"Di dalam ulangi harus ada: maju, belok, maju, ambil, lalu belok kembali.\"\n      ]\n    },\n    \"solution\": [\n      {\n        \"id\": \"s1\",\n        \"kind\": \"repeat\",\n        \"times\": 4,\n        \"body\": [\n          { \"id\": \"s2\", \"kind\": \"action\", \"action\": \"forward\" },\n          { \"id\": \"s3\", \"kind\": \"action\", \"action\": \"turnLeft\" },\n          { \"id\": \"s4\", \"kind\": \"action\", \"action\": \"forward\" },\n          { \"id\": \"s5\", \"kind\": \"action\", \"action\": \"collect\" },\n          { \"id\": \"s6\", \"kind\": \"action\", \"action\": \"turnRight\" }\n        ]\n      }\n    ]\n  },\n  {\n    \"id\": \"L2-M5\",\n    \"level\": 2,\n    \"order\": 5,\n    \"title\": \"Keliling Kebun Persegi\",\n    \"subject\": \"Matematika\",\n    \"concept\": \"looping\",\n    \"story\": \"Kebun Bu Tani berbentuk persegi dengan 4 sisi yang sama panjang. Petik semua bunga di kelilingnya!\",\n    \"goal\": \"Ambil semua 🌼 di keliling kebun. Ada pola di dalam pola!\",\n    \"world\": {\n      \"type\": \"grid\",\n      \"width\": 4,\n      \"height\": 4,\n      \"start\": { \"x\": 0, \"y\": 0, \"dir\": \"E\" },\n      \"hero\": \"🐝\",\n      \"layouts\": [[\"IIII\", \"I##I\", \"I##I\", \"IIII\"]],\n      \"legend\": { \"I\": \"🌼\", \"#\": \"🌳\" },\n      \"goal\": { \"collectAll\": true }\n    },\n    \"palette\": {\n      \"actions\": [\n        { \"action\": \"forward\", \"label\": \"Maju\", \"icon\": \"⬆️\" },\n        { \"action\": \"collect\", \"label\": \"Ambil\", \"icon\": \"✋\" },\n        { \"action\": \"turnLeft\", \"label\": \"Belok Kiri\", \"icon\": \"↩️\" },\n        { \"action\": \"turnRight\", \"label\": \"Belok Kanan\", \"icon\": \"↪️\" }\n      ],\n      \"repeat\": true\n    },\n    \"optimalBlocks\": 5,\n    \"hints\": {\n      \"tier1\": [\n        \"Persegi punya berapa sisi? Apakah setiap sisi dikerjakan dengan cara yang sama? 🟩\",\n        \"Di satu sisi, berapa kali lebah maju dan mengambil bunga?\"\n      ],\n      \"tier2\": [\n        \"Seperti berlari keliling lapangan: lari satu sisi, belok, lari lagi, belok, sampai 4 kali! 🏃\",\n        \"Kamu bisa menaruh blok ulangi di dalam blok ulangi, seperti kotak kecil di dalam kotak besar. 📦\"\n      ],\n      \"tier3\": [\n        \"Cek jumlah ulangi bagian dalam. Satu sisi berisi berapa bunga setelah titik awal?\",\n        \"Belok seharusnya terjadi setelah satu sisi selesai, bukan setelah setiap bunga.\"\n      ]\n    },\n    \"solution\": [\n      {\n        \"id\": \"s1\",\n        \"kind\": \"repeat\",\n        \"times\": 4,\n        \"body\": [\n          {\n            \"id\": \"s2\",\n            \"kind\": \"repeat\",\n            \"times\": 3,\n            \"body\": [\n              { \"id\": \"s3\", \"kind\": \"action\", \"action\": \"forward\" },\n              { \"id\": \"s4\", \"kind\": \"action\", \"action\": \"collect\" }\n            ]\n          },\n          { \"id\": \"s5\", \"kind\": \"action\", \"action\": \"turnRight\" }\n        ]\n      }\n    ]\n  }\n]\n","Description":"Level 2 (Looping) missions as structured JSON data.","Overwrite":false,"TargetFile":"e:\\codekids\\src\\content\\missions\\level-2.json","toolAction":"Writing Level 2 missions","toolSummary":"Level 2 missions"}},{"name":"write_to_file","args":{"CodeContent":"[\n  {\n    \"id\": \"L3-M1\",\n    \"level\": 3,\n    \"order\": 1,\n    \"title\": \"Genap atau Ganjil?\",\n    \"subject\": \"Matematika\",\n    \"concept\": \"conditional\",\n    \"story\": \"Robot Pos harus memilah kartu angka. Bilangan genap masuk Kotak Biru, yang lain masuk Kotak Merah!\",\n    \"goal\": \"Buat aturan JIKA–LAINNYA supaya semua angka masuk kotak yang benar.\",\n    \"world\": {\n      \"type\": \"sort\",\n      \"items\": [\n        { \"label\": \"4\", \"props\": { \"even\": true, \"gt10\": false }, \"answer\": \"blue\" },\n        { \"label\": \"7\", \"props\": { \"even\": false, \"gt10\": false }, \"answer\": \"red\" },\n        { \"label\": \"12\", \"props\": { \"even\": true, \"gt10\": true }, \"answer\": \"blue\" },\n        { \"label\": \"3\", \"props\": { \"even\": false, \"gt10\": false }, \"answer\": \"red\" },\n        { \"label\": \"8\", \"props\": { \"even\": true, \"gt10\": false }, \"answer\": \"blue\" },\n        { \"label\": \"15\", \"props\": { \"even\": false, \"gt10\": true }, \"answer\": \"red\" }\n      ],\n      \"bins\": [\n        { \"id\": \"blue\", \"label\": \"Kotak Biru\", \"emoji\": \"🟦\" },\n        { \"id\": \"red\", \"label\": \"Kotak Merah\", \"emoji\": \"🟥\" }\n      ]\n    },\n    \"palette\": {\n      \"actions\": [\n        { \"action\": \"bin:blue\", \"label\": \"Ke Kotak Biru\", \"icon\": \"🟦\" },\n        { \"action\": \"bin:red\", \"label\": \"Ke Kotak Merah\", \"icon\": \"🟥\" }\n      ],\n      \"ifElse\": true,\n      \"conditions\": [\n        { \"id\": \"gt10\", \"label\": \"lebih dari 10\" },\n        { \"id\": \"even\", \"label\": \"bilangan genap\" }\n      ]\n    },\n    \"optimalBlocks\": 3,\n    \"hints\": {\n      \"tier1\": [\n        \"Aturannya bicara soal genap. Syarat mana yang cocok dengan aturan itu? 🤔\",\n        \"Kalau syaratnya benar, angka harus ke mana? Kalau tidak benar, ke mana?\"\n      ],\n      \"tier2\": [\n        \"JIKA hujan MAKA bawa payung, LAINNYA pakai topi. Blok JIKA bekerja seperti itu! ☂️\",\n        \"Genap itu angka yang bisa dibagi dua sama rata, seperti 8 permen dibagi untuk 2 teman.\"\n      ],\n      \"tier3\": [\n        \"Lihat angka yang menyala merah. Apakah angka itu memenuhi syaratmu? Lalu cabang mana yang dijalankan?\",\n        \"Pastikan cabang MAKA dan LAINNYA sama-sama berisi satu blok tujuan.\"\n      ]\n    },\n    \"solution\": [\n      {\n        \"id\": \"s1\",\n        \"kind\": \"if\",\n        \"cond\": \"even\",\n        \"then\": [{ \"id\": \"s2\", \"kind\": \"action\", \"action\": \"bin:blue\" }],\n        \"else\": [{ \"id\": \"s3\", \"kind\": \"action\", \"action\": \"bin:red\" }]\n      }\n    ]\n  },\n  {\n    \"id\": \"L3-M2\",\n    \"level\": 3,\n    \"order\": 2,\n    \"title\": \"Terapung atau Tenggelam?\",\n    \"subject\": \"IPA\",\n    \"concept\": \"conditional\",\n    \"story\": \"Dino sedang bereksperimen di kolam. Benda yang terapung tetap di permukaan, sisanya turun ke dasar!\",\n    \"goal\": \"Buat aturan supaya setiap benda berada di tempat yang benar.\",\n    \"world\": {\n      \"type\": \"sort\",\n      \"items\": [\n        { \"label\": \"Kayu\", \"emoji\": \"🪵\", \"props\": { \"floats\": true, \"metal\": false }, \"answer\": \"surface\" },\n        { \"label\": \"Batu\", \"emoji\": \"🪨\", \"props\": { \"floats\": false, \"metal\": false }, \"answer\": \"bottom\" },\n        { \"label\": \"Daun\", \"emoji\": \"🍃\", \"props\": { \"floats\": true, \"metal\": false }, \"answer\": \"surface\" },\n        { \"label\": \"Paku besi\", \"emoji\": \"🔩\", \"props\": { \"floats\": false, \"metal\": true }, \"answer\": \"bottom\" },\n        { \"label\": \"Bebek karet\", \"emoji\": \"🦆\", \"props\": { \"floats\": true, \"metal\": false }, \"answer\": \"surface\" },\n        { \"label\": \"Kelereng\", \"emoji\": \"🔮\", \"props\": { \"floats\": false, \"metal\": false }, \"answer\": \"bottom\" }\n      ],\n      \"bins\": [\n        { \"id\": \"surface\", \"label\": \"Permukaan Air\", \"emoji\": \"🌊\" },\n        { \"id\": \"bottom\", \"label\": \"Dasar Kolam\", \"emoji\": \"⬇️\" }\n      ]\n    },\n    \"palette\": {\n      \"actions\": [\n        { \"action\": \"bin:surface\", \"label\": \"Ke Permukaan\", \"icon\": \"🌊\" },\n        { \"action\": \"bin:bottom\", \"label\": \"Ke Dasar\", \"icon\": \"⬇️\" }\n      ],\n      \"ifElse\": true,\n      \"conditions\": [\n        { \"id\": \"metal\", \"label\": \"terbuat dari besi\" },\n        { \"id\": \"floats\", \"label\": \"terapung di air\" }\n      ]\n    },\n    \"optimalBlocks\": 3,\n    \"hints\": {\n      \"tier1\": [\n        \"Pertanyaan pentingnya: benda ini terapung atau tidak? Syarat mana yang menanyakan itu? 🌊\",\n        \"Batu bukan besi, tapi apakah batu terapung?\"\n      ],\n      \"tier2\": [\n        \"Ingat saat mandi? Bebek mainan mengapung, tapi sabun batangan bisa tenggelam. Yang penting terapung atau tidak! 🛁\",\n        \"Memilih syarat itu seperti memilih pertanyaan yang tepat untuk menebak jawaban.\"\n      ],\n      \"tier3\": [\n        \"Benda yang menyala merah masuk ke tempat yang salah. Apakah syaratmu benar-benar menanyakan soal terapung?\",\n        \"Periksa lagi isi cabang MAKA dan LAINNYA, mungkin tertukar.\"\n      ]\n    },\n    \"solution\": [\n      {\n        \"id\": \"s1\",\n        \"kind\": \"if\",\n        \"cond\": \"floats\",\n        \"then\": [{ \"id\": \"s2\", \"kind\": \"action\", \"action\": \"bin:surface\" }],\n        \"else\": [{ \"id\": \"s3\", \"kind\": \"action\", \"action\": \"bin:bottom\" }]\n      }\n    ]\n  },\n  {\n    \"id\": \"L3-M3\",\n    \"level\": 3,\n    \"order\": 3,\n    \"title\": \"Kelinci Lompat Batu\",\n    \"subject\": \"IPA\",\n    \"concept\": \"conditional\",\n    \"story\": \"Kelinci mau pulang, tapi ada batu di jalan dan letaknya berubah-ubah. Satu program harus bisa dipakai di 3 jalan berbeda!\",\n    \"goal\": \"Antar 🐰 ke 🏠 di ketiga papan. JIKA ada batu, lompat!\",\n    \"world\": {\n      \"type\": \"grid\",\n      \"width\": 7,\n      \"height\": 3,\n      \"start\": { \"x\": 0, \"y\": 1, \"dir\": \"E\" },\n      \"hero\": \"🐰\",\n      \"layouts\": [\n        [\".......\", \"..O.O.G\", \".......\"],\n        [\".......\", \".O...OG\", \".......\"],\n        [\".......\", \"...O.OG\", \".......\"]\n      ],\n      \"legend\": { \"O\": \"🪨\", \"G\": \"🏠\" },\n      \"goal\": { \"reach\": true }\n    },\n    \"palette\": {\n      \"actions\": [\n        { \"action\": \"forward\", \"label\": \"Maju\", \"icon\": \"⬆️\" },\n        { \"action\": \"jump\", \"label\": \"Lompat\", \"icon\": \"🦘\" }\n      ],\n      \"repeat\": true,\n      \"ifElse\": true,\n      \"conditions\": [\n        { \"id\": \"rockAhead\", \"label\": \"ada batu di depan\" },\n        { \"id\": \"pathAhead\", \"label\": \"jalan di depan kosong\" }\n      ]\n    },\n    \"optimalBlocks\": 4,\n    \"hints\": {\n      \"tier1\": [\n        \"Letak batunya berubah-ubah. Bagaimana kelinci tahu kapan harus melompat? 🤔\",\n        \"Setiap langkah, kelinci perlu memeriksa apa dulu?\"\n      ],\n      \"tier2\": [\n        \"Seperti menyeberang jalan: JIKA ada mobil, tunggu. LAINNYA, jalan. Kita memeriksa dulu sebelum bergerak! 🚦\",\n        \"Bayangkan kamu berjalan sambil menutup mata dan temanmu bilang 'ada batu!'. Kamu baru lompat saat diberi tahu.\"\n      ],\n      \"tier3\": [\n        \"Lihat papan yang gagal. Apakah blok JIKA sudah berada di dalam blok ulangi supaya diperiksa di setiap langkah?\",\n        \"Hitung berapa kali kelinci bergerak (maju atau lompat) sampai rumah. Jumlahnya sama di ketiga papan!\"\n      ]\n    },\n    \"solution\": [\n      {\n        \"id\": \"s1\",\n        \"kind\": \"repeat\",\n        \"times\": 4,\n        \"body\": [\n          {\n            \"id\": \"s2\",\n            \"kind\": \"if\",\n            \"cond\": \"rockAhead\",\n            \"then\": [{ \"id\": \"s3\", \"kind\": \"action\", \"action\": \"jump\" }],\n            \"else\": [{ \"id\": \"s4\", \"kind\": \"action\", \"action\": \"forward\" }]\n          }\n        ]\n      }\n    ]\n  },\n  {\n    \"id\": \"L3-M4\",\n    \"level\": 3,\n    \"order\": 4,\n    \"title\": \"Panen di Kebun Sekolah\",\n    \"subject\": \"IPA\",\n    \"concept\": \"conditional\",\n    \"story\": \"Di kebun sekolah ada buah yang sudah matang dan ada tunas yang masih kecil. Petik yang matang, siram yang masih tunas!\",\n    \"goal\": \"Petik semua 🍎 dan siram semua 🌱 di 3 kebun berbeda.\",\n    \"world\": {\n      \"type\": \"grid\",\n      \"width\": 6,\n      \"height\": 3,\n      \"start\": { \"x\": 0, \"y\": 1, \"dir\": \"E\" },\n      \"hero\": \"🧑‍🌾\",\n      \"layouts\": [\n        [\"......\", \".RSSRS\", \"......\"],\n        [\"......\", \".SRRSR\", \"......\"],\n        [\"......\", \".RRSSS\", \"......\"]\n      ],\n      \"legend\": { \"R\": \"🍎\", \"S\": \"🌱\" },\n      \"goal\": { \"pickAll\": true, \"waterAll\": true }\n    },\n    \"palette\": {\n      \"actions\": [\n        { \"action\": \"forward\", \"label\": \"Maju\", \"icon\": \"⬆️\" },\n        { \"action\": \"pick\", \"label\": \"Petik\", \"icon\": \"🧺\" },\n        { \"action\": \"water\", \"label\": \"Siram\", \"icon\": \"💧\" }\n      ],\n      \"repeat\": true,\n      \"ifElse\": true,\n      \"conditions\": [\n        { \"id\": \"onSeedling\", \"label\": \"berdiri di tunas\" },\n        { \"id\": \"onRipe\", \"label\": \"berdiri di buah matang\" }\n      ]\n    },\n    \"optimalBlocks\": 5,\n    \"hints\": {\n      \"tier1\": [\n        \"Di setiap kotak, petani harus memutuskan sesuatu. Apa yang dia periksa? 🧑‍🌾\",\n        \"Apa yang harus dilakukan jika ada buah matang? Dan jika bukan?\"\n      ],\n      \"tier2\": [\n        \"Seperti ibu di pasar: JIKA buahnya matang, dibeli. LAINNYA, ditunggu dulu. 🍌\",\n        \"Gerakannya berulang (maju lalu memeriksa), tapi pekerjaannya tergantung tanamannya.\"\n      ],\n      \"tier3\": [\n        \"Lihat kotak yang menyala. Apakah petani sudah maju dulu sebelum memeriksa tanaman?\",\n        \"Pastikan blok JIKA ada di dalam ulangi, dan cabang LAINNYA tidak kosong.\"\n      ]\n    },\n    \"solution\": [\n      {\n        \"id\": \"s1\",\n        \"kind\": \"repeat\",\n        \"times\": 5,\n        \"body\": [\n          { \"id\": \"s2\", \"kind\": \"action\", \"action\": \"forward\" },\n          {\n            \"id\": \"s3\",\n            \"kind\": \"if\",\n            \"cond\": \"onRipe\",\n            \"then\": [{ \"id\": \"s4\", \"kind\": \"action\", \"action\": \"pick\" }],\n            \"else\": [{ \"id\": \"s5\", \"kind\": \"action\", \"action\": \"water\" }]\n          }\n        ]\n      }\n    ]\n  },\n  {\n    \"id\": \"L3-M5\",\n    \"level\": 3,\n    \"order\": 5,\n    \"title\": \"Tiga Kotak Bilangan\",\n    \"subject\": \"Matematika\",\n    \"concept\": \"conditional\",\n    \"story\": \"Robot Pos punya kotak baru! Kelipatan 5 masuk Kotak Kuning, selain itu bilangan genap ke Kotak Biru, sisanya ke Kotak Merah.\",\n    \"goal\": \"Buat aturan bertingkat: periksa kelipatan 5 dulu, baru genap.\",\n    \"world\": {\n      \"type\": \"sort\",\n      \"items\": [\n        { \"label\": \"10\", \"props\": { \"mult5\": true, \"even\": true }, \"answer\": \"yellow\" },\n        { \"label\": \"7\", \"props\": { \"mult5\": false, \"even\": false }, \"answer\": \"red\" },\n        { \"label\": \"4\", \"props\": { \"mult5\": false, \"even\": true }, \"answer\": \"blue\" },\n        { \"label\": \"15\", \"props\": { \"mult5\": true, \"even\": false }, \"answer\": \"yellow\" },\n        { \"label\": \"9\", \"props\": { \"mult5\": false, \"even\": false }, \"answer\": \"red\" },\n        { \"label\": \"12\", \"props\": { \"mult5\": false, \"even\": true }, \"answer\": \"blue\" },\n        { \"label\": \"20\", \"props\": { \"mult5\": true, \"even\": true }, \"answer\": \"yellow\" }\n      ],\n      \"bins\": [\n        { \"id\": \"yellow\", \"label\": \"Kotak Kuning\", \"emoji\": \"🟨\" },\n        { \"id\": \"blue\", \"label\": \"Kotak Biru\", \"emoji\": \"🟦\" },\n        { \"id\": \"red\", \"label\": \"Kotak Merah\", \"emoji\": \"🟥\" }\n      ]\n    },\n    \"palette\": {\n      \"actions\": [\n        { \"action\": \"bin:yellow\", \"label\": \"Ke Kotak Kuning\", \"icon\": \"🟨\" },\n        { \"action\": \"bin:blue\", \"label\": \"Ke Kotak Biru\", \"icon\": \"🟦\" },\n        { \"action\": \"bin:red\", \"label\": \"Ke Kotak Merah\", \"icon\": \"🟥\" }\n      ],\n      \"ifElse\": true,\n      \"conditions\": [\n        { \"id\": \"even\", \"label\": \"bilangan genap\" },\n        { \"id\": \"mult5\", \"label\": \"kelipatan 5\" }\n      ]\n    },\n    \"optimalBlocks\": 5,\n    \"hints\": {\n      \"tier1\": [\n        \"Angka 10 itu genap DAN kelipatan 5. Menurut aturan, ia harus masuk kotak mana? 🤔\",\n        \"Ada 3 kotak, tapi satu blok JIKA hanya punya 2 cabang. Bagaimana caranya?\"\n      ],\n      \"tier2\": [\n        \"Seperti satpam sekolah: JIKA guru, silakan masuk. LAINNYA, JIKA siswa, ke kelas. LAINNYA, ke ruang tamu. 🏫\",\n        \"Kamu bisa menaruh blok JIKA di dalam cabang LAINNYA, seperti pertanyaan kedua setelah jawaban 'tidak'.\"\n      ],\n      \"tier3\": [\n        \"Lihat angka yang menyala merah. Syarat mana yang kamu periksa duluan? Aturannya meminta kelipatan 5 diperiksa lebih dulu.\",\n        \"Cabang LAINNYA dari pertanyaan pertama butuh satu pertanyaan lagi.\"\n      ]\n    },\n    \"solution\": [\n      {\n        \"id\": \"s1\",\n        \"kind\": \"if\",\n        \"cond\": \"mult5\",\n        \"then\": [{ \"id\": \"s2\", \"kind\": \"action\", \"action\": \"bin:yellow\" }],\n        \"else\": [\n          {\n            \"id\": \"s3\",\n            \"kind\": \"if\",\n            \"cond\": \"even\",\n            \"then\": [{ \"id\": \"s4\", \"kind\": \"action\", \"action\": \"bin:blue\" }],\n            \"else\": [{ \"id\": \"s5\", \"kind\": \"action\", \"action\": \"bin:red\" }]\n          }\n        ]\n      }\n    ]\n  }\n]\n","Description":"Level 3 (Conditional) missions as structured JSON data.","Overwrite":false,"TargetFile":"e:\\codekids\\src\\content\\missions\\level-3.json","toolAction":"Writing Level 3 missions","toolSummary":"Level 3 missions"}}]}
