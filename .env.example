# Salin file ini menjadi .env.local (dan .env untuk Prisma CLI) lalu isi nilainya.

# Database SQLite lokal (atau PostgreSQL untuk produksi)
DATABASE_URL="file:./dev.db"

# Rahasia untuk menandatangani cookie sesi (minimal 32 karakter acak)
AUTH_SECRET="ganti-dengan-string-acak-panjang-minimal-32-karakter"

# Gemini API
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"

# Gmail SMTP Configuration (untuk verifikasi email & reset kata sandi)
EMAIL_USER=""
EMAIL_PASS=""

# URL Aplikasi (wajib untuk callback OAuth produksi)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth 2.0 Credentials (opsional, jika kosong sistem otomatis beralih ke Mode Demo)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
